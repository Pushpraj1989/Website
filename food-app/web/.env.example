# Copy to .env.local and fill in. Never commit real values.

# Postgres connection string. Local: postgres://postgres@127.0.0.1:5432/food. Supabase: the pooler URL from the project settings.
DATABASE_URL=

# Staff sign-in for the slice (shared password, 12 characters or more). Replaced by staff accounts in the Supabase layer.
ADMIN_PASSWORD=

# Stripe, test mode first (test keys start with sk_test_ / pk_test_). Card payment is hidden until both secrets are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# One-time codes. Development writes them to data/outbox.jsonl (never sent to a client).
# Production refuses to send until delivery is set: OTP_DELIVERY=smtp sends email codes through these settings.
OTP_DELIVERY=
OTP_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 32 random bytes, base64 encoded (openssl rand -base64 32). Encrypts AI provider keys at rest. Required in production;
# losing it makes stored provider keys unreadable, so back it up in the secret manager, never in the repository.
APP_ENCRYPTION_KEY=
