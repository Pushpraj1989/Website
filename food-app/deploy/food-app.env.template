# Settings for the ordering system. setup.sh copies this to /etc/food-app.env and fills in the generated lines.
# Readable only by root and the service. Never paste these values into a chat, a ticket or the repository.
# After any change: systemctl restart food-app   (a change to NEXT_PUBLIC_ lines needs update.sh instead)

# ---- Generated by setup.sh. Leave as they are. Back up APP_ENCRYPTION_KEY somewhere safe: without it, stored
# ---- assistant keys and printed voucher codes cannot be read again.
PUBLIC_URL=
STAFF_URL="/console/"
DATABASE_URL=
ADMIN_PASSWORD=
OTP_SECRET=
APP_ENCRYPTION_KEY=
PARTNER_KEY_SECRET=
VOUCHER_CODE_SECRET=

# ---- Sign-in codes by email. Fill these in from your email provider (for Hostinger email: host smtp.hostinger.com,
# ---- port 465, the full mailbox address as the user, and that mailbox's password).
OTP_DELIVERY="smtp"
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# The address customers see the code come from. Usually the same mailbox as SMTP_USER.
SMTP_FROM=""

# ---- Address search at checkout (OpenStreetMap Nominatim). Its rules ask for a name and a contact, for example:
# ---- PLACES_USER_AGENT="YourRestaurant-ordering/1.0 (orders@yourdomain.com)"
PLACES_USER_AGENT=""

# ---- Card payments (optional; cash works without them). Card payment stays hidden until all three are set.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
