{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UX Gate Score",
  "type": "object",
  "required": ["ratings", "hard_stops", "open_s1"],
  "properties": {
    "ratings": {
      "type": "object",
      "required": ["task_success", "accessibility", "usability", "cognitive_clarity", "information_architecture", "interaction_quality", "error_recovery", "cultural_local", "visual_craft", "content_clarity", "responsive", "design_system", "trust_ethics"],
      "additionalProperties": false,
      "properties": {
        "task_success": {"type": "number", "minimum": 0, "maximum": 5},
        "accessibility": {"type": "number", "minimum": 0, "maximum": 5},
        "usability": {"type": "number", "minimum": 0, "maximum": 5},
        "cognitive_clarity": {"type": "number", "minimum": 0, "maximum": 5},
        "information_architecture": {"type": "number", "minimum": 0, "maximum": 5},
        "interaction_quality": {"type": "number", "minimum": 0, "maximum": 5},
        "error_recovery": {"type": "number", "minimum": 0, "maximum": 5},
        "cultural_local": {"type": "number", "minimum": 0, "maximum": 5},
        "visual_craft": {"type": "number", "minimum": 0, "maximum": 5},
        "content_clarity": {"type": "number", "minimum": 0, "maximum": 5},
        "responsive": {"type": "number", "minimum": 0, "maximum": 5},
        "design_system": {"type": "number", "minimum": 0, "maximum": 5},
        "trust_ethics": {"type": "number", "minimum": 0, "maximum": 5}
      }
    },
    "hard_stops": {"type": "array", "items": {"type": "string"}},
    "open_s1": {"type": "integer", "minimum": 0}
  }
}
