# Copy to /etc/azaiba-cms.env on the server (chmod 600, owned by root). Never commit the real file.
CMS_HOST=127.0.0.1
CMS_PORT=8800
# The public address of the CMS as the browser sees it. Must match the nginx server_name.
CMS_PUBLIC_URL=https://cms.example.com
# The website's folder inside the repo; the CMS rebuilds this one site.
CMS_SITE=azaiba-gardens
CMS_IMG_DIR=azaiba-gardens
# Python 3 with jinja2 and pillow (see README). Use the venv's python if you made one.
CMS_PYTHON=python3
CMS_COOKIE_SECURE=true
# Email for invitations and password resets. Hostinger: copy the SMTP details from hPanel > Emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=change-me
SMTP_FROM=Azaiba Gardens <noreply@example.com>
