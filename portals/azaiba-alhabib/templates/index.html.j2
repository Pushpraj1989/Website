{% extends "base.html.j2" %}
{% block content %}
<section class="hero">
  {% if site.hero_video %}
  <video class="hero-video" autoplay muted loop playsinline preload="auto" poster="{{ root }}media/{{ buildings[0].cover }}" aria-hidden="true" tabindex="-1">
    {%- if site.hero_webm %}<source src="{{ root }}media/{{ site.hero_webm }}" type="video/webm">{% endif %}
    <source src="{{ root }}media/{{ site.hero_video }}" type="{{ 'video/webm' if site.hero_video.endswith('.webm') else 'video/mp4' }}">
  </video>
  {% endif %}
  <div class="wrap">
    <p class="eyebrow">{{ site.location }}</p>
    <h1>{{ site.hero_title }}</h1>
    <p class="lede">{{ site.hero_lede }}</p>
    <div class="hero-tabs" role="tablist" aria-label="Looking to">
      <a role="tab" aria-selected="true" href="{{ root }}search.html?transaction=rent">For Rent</a>
      <a role="tab" aria-selected="false" href="{{ root }}search.html?transaction=sale">For Sale</a>
    </div>
    <form class="search hero-search" action="{{ root }}search.html" method="get" role="search">
      <label class="field"><span>Cities</span><select name="city"><option>Muscat</option></select></label>
      <label class="field"><span>Areas</span><select name="area"><option>Azaiba</option></select></label>
      <label class="field"><span>Bedrooms</span>
        <select name="bhk"><option value="">All</option><option>1 BHK</option><option>2 BHK</option><option>3 BHK</option></select></label>
      <label class="field range"><span>Price range <output id="price-out">OMR 0 - OMR 1000</output></span>
        <input type="range" name="max" min="0" max="1000" step="5" value="1000" aria-describedby="price-out" data-range-out="price-out"></label>
      <button class="btn btn-blue" type="submit">Search</button>
    </form>
  </div>
</section>

{% if site.video %}
<section class="wrap video-band">
  <video controls playsinline preload="metadata" poster="{{ root }}media/{{ buildings[0].cover }}">
    <source src="{{ root }}media/{{ site.video }}" type="video/mp4">
  </video>
  <div>
    <h2>The building in motion</h2>
    <p>A short film of the buildings and their surroundings.</p>
  </div>
</section>
{% endif %}

<section class="wrap">
  <div class="section-head"><h2>Featured flats</h2><div class="view-toggle" role="group" aria-label="Show as"><button type="button" data-view-set="cards" aria-pressed="true">Cards</button><button type="button" data-view-set="list" aria-pressed="false">List</button></div><a href="{{ root }}search.html">All flats →</a></div>
  <div class="cards view-target">
    {% for item in featured %}
    <a class="card" href="{{ root }}listing/{{ item.id }}.html">
      <span class="badge b-feat">Featured</span><span class="badge b-rent">For rent</span>
      <img src="{{ root }}media/{{ item.cover }}" alt="{{ item.title }}" loading="lazy">
      <div class="card-body">
        <p class="price">{{ item.rent_text }} <small>{{ item.period_text }}</small></p>
        <h3>{{ item.bhk }} flat</h3>
        <p class="muted">{{ item.building_record.name }} · {{ item.size_text }}</p>
      </div>
    </a>
    {% endfor %}
  </div>
</section>

<section class="wrap">
  <div class="section-head"><h2>Our buildings</h2><div class="view-toggle" role="group" aria-label="Show as"><button type="button" data-view-set="cards" aria-pressed="true">Cards</button><button type="button" data-view-set="list" aria-pressed="false">List</button></div></div>
  <div class="cards view-target">
    {% for b in buildings %}
    <a class="card" href="{{ root }}building/{{ b.id }}.html">
      <img src="{{ root }}media/{{ b.cover }}" alt="{{ b.name }}" loading="lazy">
      <div class="card-body">
        <h3>{{ b.name }}</h3>
        <p class="muted">{{ b.area }} · {{ b.floors }} floors · {{ b.units }} units</p>
        <p class="price">From {{ site.currency }} {{ b.from_rent }} <small>/ month</small></p>
      </div>
    </a>
    {% endfor %}
  </div>
</section>
{% endblock %}
