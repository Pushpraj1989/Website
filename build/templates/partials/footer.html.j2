<footer class="site-footer">
  <div class="wrap">
    <p class="foot-big" aria-hidden="true" data-drift="14">{{ s.short }}</p>
    <div class="foot-grid">
      <div>
        <a class="brand" href="index.html">{% if s.brand and s.brand.logo %}<img class="brand-logo{% if s.brand.logo_wide %} is-wide{% endif %}" src="assets/img/{{ s.images[s.brand.logo].src }}" alt="" width="44" height="44">{% else %}<span class="brand-mark" aria-hidden="true">{{ s.short[0] }}</span>{% endif %}{% if not (s.brand and s.brand.logo_wide) %}<span class="brand-text">{{ s.short }}</span>{% endif %}</a>
        <p style="margin-top:1rem;max-width:38ch">{{ s.meta }}</p>
      </div>
      <nav class="foot-nav" aria-label="Footer">
        <p class="foot-h">Explore</p>
        <a href="index.html">Home</a>
        {%- for n in s._nav %}<a href="{{ n.file }}">{{ n.label }}</a>{% endfor %}
      </nav>
      {%- for n in s._nav if n['items'] %}{% if loop.first %}
      <nav class="foot-nav" aria-label="{{ n.label }}">
        <p class="foot-h">{{ n.label }}</p>
        {%- for it in n['items'][:8] %}<a href="{{ it._file }}">{{ it.title }}</a>{% endfor %}
      </nav>
      {%- endif %}{% endfor %}
      <div class="foot-contact">
        {% if s.contact.address %}<p>{{ s.contact.address }}</p>{% endif %}
        {% for p in s.contact.phones if not p.fax %}<p><a href="tel:{{ p.tel }}">{{ p.number }}</a></p>{% endfor %}
        {% if s.contact.email %}<p><a href="mailto:{{ s.contact.email }}">{{ s.contact.email }}</a></p>{% endif %}
      </div>
    </div>
    <div class="foot-bottom">
      <p>© {{ year }} {{ s.name }}. <span>{{ s.footer_note or "Concept redesign, not the company's official website. Facts to be verified before use." }}</span></p>
      <a href="#top">Back to top</a>
    </div>
    {%- if s._credits %}
    <details class="credits">
      <summary>Image credits</summary>
      <ul dir="ltr" lang="en">
        {%- for c in s._credits %}
        <li>“{{ c.title }}”{% if c.creator %} by {{ c.creator }}{% endif %}, {% if c.license_url %}<a href="{{ c.license_url }}" rel="license noopener">{{ c.license }}</a>{% else %}{{ c.license }}{% endif %}{% if c.landing %} · <a href="{{ c.landing }}" rel="noopener">source</a>{% endif %}{% if c.modified %} · cropped and colour-graded{% endif %}</li>
        {%- endfor %}
      </ul>
    </details>
    {%- endif %}
  </div>
</footer>
