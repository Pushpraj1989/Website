{#- Shared macros. `s` (site data) comes from the render context. -#}
{%- macro count(st) -%}
<span data-count data-to="{{ st.value }}" data-suffix="{{ st.suffix or '' }}">{{ '{:,}'.format(st.value) }}{{ st.suffix or '' }}</span>
{%- endmacro -%}

{%- macro img(role, cls='', anim='', speed='', sizes='') -%}
{%- set im = s.images[role] -%}
<figure class="media {{ cls }}"{% if anim %} data-anim="{{ anim }}"{% endif %}>
  <img src="assets/img/{{ im.src }}" alt="{{ im.alt }}" loading="{{ 'eager' if role == 'hero' else 'lazy' }}" decoding="async"{% if speed %} data-speed="{{ speed }}"{% endif %}>
  {%- if im.cap %}<figcaption class="media-cap">{{ im.cap }}</figcaption>{% endif %}
</figure>
{%- endmacro -%}

{%- macro src(role) -%}assets/img/{{ s.images[role].src }}{%- endmacro -%}

{%- macro marquee(items, speed=1, dir='left', cls='') -%}
<div class="marquee {{ cls }}" data-marquee="{{ speed }}" data-dir="{{ dir }}" aria-label="{{ items | join(', ') }}">
  <div class="marquee-track" aria-hidden="true">
    {%- for pass in [0, 1] %}
    <div class="marquee-group">{% for m in items %}<span class="mq-item">{{ m }}</span><span class="mq-sep"></span>{% endfor %}</div>
    {%- endfor %}
  </div>
</div>
{%- endmacro -%}

{%- macro locations(dark=false) -%}
{%- if s.locations and s.locations['items'] %}
  {%- if s._show_filter %}
  <div class="filters" role="group" aria-label="Filter locations by country" data-filters>
    <button class="filter" type="button" data-filter="all" aria-pressed="true">All <span class="filter-n">{{ s.locations['items'] | length }}</span></button>
    {%- for c, n in s._countries %}
    <button class="filter" type="button" data-filter="{{ c }}" aria-pressed="false">{{ c }} <span class="filter-n">{{ n }}</span></button>
    {%- endfor %}
  </div>
  {%- endif %}
  <p class="result-count" aria-live="polite" data-result></p>
  <ul class="loc-grid">
    {%- for l in s.locations['items'] %}
    <li class="loc{% if l.image %} loc-img{% endif %}" data-country="{{ l.country }}">
      {%- if l.image %}<img class="loc-bg" src="assets/img/{{ s.images[l.image].src }}" alt="" loading="lazy" decoding="async"><span class="loc-cap">{{ s.images[l.image].cap }}</span>{% endif %}
      <div class="loc-top"><span class="pill">{{ l.type }}</span><span>{{ l.country }}</span></div>
      <h3>{{ l.name }}</h3>
      {% if l.address %}<p>{{ l.address }}</p>{% endif %}
      {% if l.phone %}<a href="tel:{{ digits(l.phone) }}">{{ l.phone }}</a>{% endif %}
      {% if l.note %}<p class="note">{{ l.note }}</p>{% endif %}
    </li>
    {%- endfor %}
  </ul>
  <p class="empty" data-empty hidden>No locations match this filter.</p>
{%- endif %}
{%- endmacro -%}

{%- macro curve() -%}
{%- set L = s.locations['items'] %}
<div class="curve" data-curve tabindex="0" aria-roledescription="carousel" aria-label="{{ s.locations.nav or 'Locations' }}">
  <div class="filters curve-filters" role="group" aria-label="Filter by country">
    <button class="filter" type="button" data-cfilter="all" aria-pressed="true">All <span class="filter-n">{{ L | length }}</span></button>
    {%- for c, n in s._countries %}
    <button class="filter" type="button" data-cfilter="{{ c }}" aria-pressed="false">{{ c }} <span class="filter-n">{{ n }}</span></button>
    {%- endfor %}
  </div>
  <div class="curve-stage" data-cursor="Drag">
    <ul class="curve-track">
      {%- for l in L %}
      {%- set im = s.images[l.image] if l.image else none %}
      <li class="curve-card" data-i="{{ loop.index0 }}" data-c="{{ l.country }}">
        <img class="cc-bg" src="assets/img/{{ im.src if im else '' }}" alt="" loading="lazy" decoding="async" draggable="false">
        <div class="cc-top"><span class="cc-pill">{{ l.type }}</span>{% if l.emergency %}<span class="cc-er" title="Emergency open 24/7"><i></i>24/7</span>{% else %}<span>{{ l.country }}</span>{% endif %}</div>
        <div class="cc-bottom">
          <span class="cc-n">{{ '%02d' % loop.index }} · {{ l.country }}</span>
          <h3>{{ l.name }}</h3>
          {% if im %}<span class="cc-cap">{{ im.cap }}</span>{% endif %}
        </div>
        <div class="cc-actions" aria-hidden="true">
          {%- set ph = (l.phones[0].number if l.phones else l.phone) %}
          {%- if ph %}<a href="tel:{{ digits(ph) }}" tabindex="-1">{{ icon('phone') }}<span>Call</span></a>{% endif %}
          <a href="{{ (l.links.directions if l.links and l.links.directions else l._map) }}" target="_blank" rel="noopener" tabindex="-1">{{ icon('pin') }}<span>Directions</span></a>
          {%- if l._file %}<a href="{{ l._file }}" tabindex="-1">{{ icon('arrow') }}<span>Details</span></a>{% endif %}
        </div>
      </li>
      {%- endfor %}
    </ul>
  </div>
  <div class="curve-nav">
    <button class="curve-btn" type="button" data-cprev aria-label="Previous">{{ icon('arrow') }}</button>
    <div class="curve-progress"><span data-counter>01 / {{ '%02d' % L | length }}</span><i><b data-cbar></b></i></div>
    <button class="curve-btn next" type="button" data-cnext aria-label="Next">{{ icon('arrow') }}</button>
  </div>

  {#- dynamic detail panel: filled from the JSON below as the slider moves -#}
  <div class="bpanel" aria-live="polite">
    <div class="bp-info">
      <div class="bp-head">
        <span class="bp-type" data-b="type"></span><span class="bp-er" data-b="er" hidden><i></i>Emergency 24/7</span><span class="bp-open" data-b="opened" hidden></span>
      </div>
      <h3 class="bp-name" data-b="name"></h3>
      <p class="bp-full" data-b="full"></p>
      <p class="bp-addr" data-b="addr"></p>
      <div class="bp-grid">
        <div class="bp-block">
          <p class="bp-h">{{ icon('clock') }} Timings</p>
          <ul class="bp-hours" data-b="hours"></ul>
        </div>
        <div class="bp-block">
          <p class="bp-h">{{ icon('phone') }} Contact</p>
          <ul class="bp-phones" data-b="phones"></ul>
        </div>
      </div>
      <div class="bp-stats">
        <div><strong data-b="docs">–</strong><span>doctors</span></div>
        <div><strong data-b="nspec">–</strong><span>specialities</span></div>
      </div>
      <ul class="bp-specs" data-b="specs"></ul>
      <div class="bp-actions">
        <a class="btn btn-primary btn-sm" href="contact.html" data-b="book" data-magnetic>{{ s.cta.label }} {{ icon('arrow') }}</a>
        <a class="bp-act" href="#" data-b="page">{{ icon('layers') }}<span>Branch page</span></a>
        <a class="bp-act" href="#" data-b="dir" target="_blank" rel="noopener">{{ icon('pin') }}<span>Directions</span></a>
        <a class="bp-act" href="#" data-b="rev" target="_blank" rel="noopener" hidden>{{ icon('star') }}<span>Reviews</span></a>
        <a class="bp-act" href="#" data-b="ig" target="_blank" rel="noopener" hidden>{{ icon('globe') }}<span>Instagram</span></a>
      </div>
    </div>
    <div class="bp-map">
      <iframe data-b="map" title="Map" loading="lazy" referrerpolicy="no-referrer-when-downgrade" tabindex="-1"></iframe>
      <div class="bp-map-veil" data-b="veil"><span>{{ icon('pin') }}</span><p>Loading map…</p></div>
      <a class="bp-map-btn" href="#" data-b="dir2" target="_blank" rel="noopener">{{ icon('pin') }} Open in Google Maps</a>
    </div>
  </div>
  <script type="application/json" data-branches>{{ s._branch_json | safe }}</script>
  <noscript><p>Full list of {{ s.locations.nav | lower if s.locations.nav else 'locations' }} below.</p></noscript>
</div>
{%- endmacro -%}

{%- macro news_grid(items) -%}
<div class="news-grid">
  {%- for n in items %}
  <a class="news-card" href="{{ n._file }}" data-tag="{{ n.tag }}" data-anim="up" data-delay="{{ (loop.index0 % 3) * 0.08 }}">
    <div class="nc-media">{% if n._img %}<img src="{{ src(n._img) }}" alt="" loading="lazy">{% endif %}<span class="nc-tag">{{ n.tag }}</span></div>
    <p class="news-meta">{{ n.date }}</p>
    <h3>{{ n.title }}</h3>
    <p class="nc-sum">{{ n.summary }}</p>
    <span class="text-link">Read {{ icon('arrow') }}</span>
  </a>
  {%- endfor %}
</div>
{%- endmacro -%}

{%- macro promo() -%}
{#- Hero promotion slider: WebGL displacement transitions between slides (CSS wipe fallback),
    autoplay with progress, tabs, swipe. Themes can pass an ambient overlay via call(). -#}
<section class="promo promo-{{ s.promo_fx or 'flow' }}" id="top" data-promo="{{ s.promo_fx or 'flow' }}" aria-roledescription="carousel" aria-label="Highlights">
  <div class="promo-stage">
    {%- for p in s.promos %}
    <div class="promo-bg{% if loop.first %} is-on{% endif %}{% if p.video %} has-video{% endif %}" data-src="{{ src(p.image) }}"><img src="{{ src(p.image) }}" alt="{{ s.images[p.image].alt }}" {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
      {%- if p.video %}<video class="promo-vid" muted loop playsinline preload="{{ 'auto' if loop.first else 'none' }}" poster="{{ src(p.image) }}" data-src="assets/media/{{ p.video }}" aria-hidden="true"></video>{% endif %}</div>
    {%- endfor %}
    <canvas class="promo-gl" aria-hidden="true"></canvas>
    <div class="promo-shade" aria-hidden="true"></div>
    {%- if caller %}{{ caller() }}{% endif %}
  </div>
  <div class="wrap promo-copy-wrap">
    {%- for p in s.promos %}
    <div class="promo-copy{% if loop.first %} is-on{% endif %}" role="group" aria-roledescription="slide" aria-label="{{ loop.index }} of {{ loop.length }}"{% if not loop.first %} aria-hidden="true"{% endif %}>
      <p class="promo-k">{% if p.tag %}<b>{{ p.tag }}</b>{% endif %}{{ p.kicker }}</p>
      {% if loop.first %}<h1 class="promo-t">{{ p.title }}</h1>{% else %}<h2 class="promo-t">{{ p.title }}</h2>{% endif %}
      <p class="promo-p">{{ p.text }}</p>
      <div class="cta-row">
        {%- if p.cta %}<a class="btn btn-primary" href="{{ p.cta.href }}" data-magnetic{% if not loop.first %} tabindex="-1"{% endif %}>{{ p.cta.label }} {{ icon('arrow') }}</a>{% endif %}
        {%- if p.cta2 %}<a class="btn btn-ghost" href="{{ p.cta2.href }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ p.cta2.label }}</a>{% endif %}
      </div>
      {%- if s.images[p.image].cap %}<span class="promo-cap">{{ s.images[p.image].cap }}</span>{% endif %}
    </div>
    {%- endfor %}
  </div>
  <div class="wrap promo-ui">
    <div class="promo-tabs" role="tablist">
      {%- for p in s.promos %}
      <button class="promo-tab{% if loop.first %} is-on{% endif %}" type="button" role="tab" aria-selected="{{ 'true' if loop.first else 'false' }}" data-go="{{ loop.index0 }}">
        <span class="pt-n">{{ '%02d' % loop.index }}</span><span class="pt-l">{{ p.short or p.kicker }}</span><i class="pt-bar"><b></b></i>
      </button>
      {%- endfor %}
    </div>
    <div class="promo-arrows">
      <button type="button" class="promo-arrow prev" data-pprev aria-label="Previous slide">{{ icon('arrow') }}</button>
      <button type="button" class="promo-arrow" data-pnext aria-label="Next slide">{{ icon('arrow') }}</button>
      <button type="button" class="promo-pause" data-ppause aria-label="Pause slideshow" aria-pressed="false"><span></span><span></span></button>
    </div>
  </div>
</section>
{%- endmacro -%}

{%- macro rail() -%}
{#- "How can we help?" quick actions that overlap the bottom of the promo slider -#}
{%- if s.rail %}
<section class="rail" aria-label="{{ s.rail.title or 'Quick actions' }}">
  <div class="wrap">
    <div class="rail-box" data-anim="up">
      <p class="rail-t">{{ s.rail.title or 'How can we help?' }}</p>
      <div class="rail-items">
        {%- for r in s.rail['items'] %}
        <a class="rail-item" href="{{ r.href }}"{% if r.href.startswith('http') %} rel="noopener"{% endif %}>
          <span class="rail-ico">{{ icon(r.icon) }}</span>
          <span class="rail-l"><b>{{ r.label }}</b>{% if r.sub %}<small>{{ r.sub }}</small>{% endif %}</span>
          <span class="rail-go">{{ icon('arrow') }}</span>
        </a>
        {%- endfor %}
      </div>
    </div>
  </div>
</section>
{%- endif %}
{%- endmacro -%}

{%- macro home_news() -%}
{%- if s.news %}
<section class="home-news" id="news">
  <div class="wrap">
    <div class="home-news-head">
      <div><p class="eyebrow">Newsroom</p><h2 class="pg-h2" data-anim="lines">{{ s.news_title or 'Latest news and updates' }}</h2></div>
      <a class="btn btn-ghost" href="news.html" data-magnetic>All news {{ icon('arrow') }}</a>
    </div>
    {{ news_grid(s.news[:3]) }}
  </div>
</section>
{%- endif %}
{%- endmacro -%}

{%- macro faq() -%}
{%- if s.faq %}
<section class="faq" id="faq">
  <div class="wrap faq-grid">
    <div>
      <p class="eyebrow">FAQ</p>
      <h2 class="pg-h2" data-anim="lines">{{ s.faq_title or 'Questions people ask' }}</h2>
      <p class="muted" data-anim="up">Can't find an answer? <a href="contact.html">Contact us</a>.</p>
    </div>
    <div class="faq-list">
      {%- for q in s.faq %}
      <details class="faq-item" data-anim="up"{% if loop.first %} open{% endif %}>
        <summary><span>{{ q.q }}</span><i aria-hidden="true"></i></summary>
        <div class="faq-a"><p>{{ q.a }}</p></div>
      </details>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}
{%- endmacro -%}

{%- macro bmi() -%}
<section class="tool" id="tools">
  <div class="wrap tool-grid">
    <div>
      <p class="eyebrow">Health tools</p>
      <h2 class="pg-h2" data-anim="lines">Check your body mass index</h2>
      <p class="muted" data-anim="up">A quick screening figure, worked out on your device. Nothing is sent anywhere. It is not a diagnosis; a doctor can tell you what it means for you.</p>
    </div>
    <form class="bmi" data-bmi novalidate>
      <label>Height <span><input type="range" min="120" max="210" value="168" name="h"><output data-o="h">168 cm</output></span></label>
      <label>Weight <span><input type="range" min="30" max="180" value="70" name="w"><output data-o="w">70 kg</output></span></label>
      <div class="bmi-out">
        <div class="bmi-dial"><svg viewBox="0 0 200 110" aria-hidden="true"><path class="bmi-track" d="M15 100a85 85 0 0 1 170 0"/><path class="bmi-arc" d="M15 100a85 85 0 0 1 170 0" pathLength="100" data-arc/></svg><strong data-bmi-v>24.8</strong></div>
        <p class="bmi-band" data-bmi-band aria-live="polite">Healthy range</p>
        <p class="bmi-note">WHO adult ranges: under 18.5 underweight, 18.5 to 24.9 healthy, 25 to 29.9 overweight, 30 and over obese.</p>
        <a class="btn btn-primary btn-sm" href="{{ s.bmi_href or 'contact.html' }}">{{ s.bmi_cta or 'Book a check-up' }} {{ icon('arrow') }}</a>
      </div>
    </form>
  </div>
</section>
{%- endmacro -%}

{%- macro testimonials() -%}
{%- if s.testimonials %}
<section class="quotes" aria-label="Patient stories" data-quotes>
  <div class="wrap">
    <p class="eyebrow">Patient stories</p>
    <div class="q-stage">
      {%- for t in s.testimonials %}
      <figure class="q-item{% if loop.first %} is-on{% endif %}">
        <blockquote>“{{ t.text }}”</blockquote>
        <figcaption><span class="q-av" aria-hidden="true">{{ t.name[0] }}</span><b>{{ t.name }}</b><span>{{ t.date }}</span></figcaption>
      </figure>
      {%- endfor %}
    </div>
    <div class="q-ui">
      <div class="q-dots">{% for t in s.testimonials %}<button type="button" aria-label="Story {{ loop.index }}" data-q="{{ loop.index0 }}"{% if loop.first %} class="is-on"{% endif %}></button>{% endfor %}</div>
      <p class="q-note">{{ s.testimonials_note or "Testimonials as published on the company's website." }}</p>
    </div>
  </div>
</section>
{%- endif %}
{%- endmacro -%}

{%- macro insurance() -%}
{%- if s.insurance %}
<section class="ins" aria-label="Insurance partners">
  <div class="wrap ins-head">
    <p class="eyebrow">Insurance</p>
    <h2 class="pg-h2" data-anim="lines">{{ s.insurance.intro }}</h2>
  </div>
  {%- set half = (s.insurance.partners | length / 2) | round(0, 'ceil') | int %}
  {%- for row, dir in [(s.insurance.partners[:half], 'left'), (s.insurance.partners[half:], 'right')] %}
  <div class="marquee ins-row" data-marquee="0.6" data-dir="{{ dir }}">
    <div class="marquee-track" aria-hidden="true">
      {%- for pass in [0, 1] %}<div class="marquee-group">{% for p in row %}<span class="ins-chip">{{ p }}</span>{% endfor %}</div>{% endfor %}
    </div>
  </div>
  {%- endfor %}
  <p class="wrap visually-hidden">Partners: {{ s.insurance.partners | join(', ') }}</p>
</section>
{%- endif %}
{%- endmacro -%}

{%- macro assemble(a) -%}
{#- Exploded product that builds itself on scroll. Layers come from build/art.py (one <g> per layer). -#}
<section class="asm" id="{{ a.id }}" data-assemble aria-label="{{ a.title }}">
  <div class="asm-pin">
    <div class="wrap asm-grid">
      <div class="asm-copy">
        <p class="eyebrow">{{ a.kicker or 'Inside the product' }}</p>
        <h2 class="asm-title">{{ a.title }}</h2>
        {%- if a.intro %}<p class="asm-intro">{{ a.intro }}</p>{% endif %}
        <ol class="asm-parts">
          {%- for l in a._parts | reverse %}
          {%- set idx = a._parts | length - loop.index %}
          <li data-part="{{ idx }}" style="--c: {{ l.color or 'var(--accent)' }}"><i></i><div><b>{{ l.name }}</b>{% if l.note %}<span>{{ l.note }}</span>{% endif %}</div></li>
          {%- endfor %}
        </ol>
        {%- if a.cta %}<a class="btn btn-primary asm-cta" href="{{ a.cta.href }}" data-magnetic>{{ a.cta.label }} {{ icon('arrow') }}</a>{% endif %}
      </div>
      <div class="asm-stage">
        <div class="asm-glow" aria-hidden="true"></div>
        <svg class="asm-svg" viewBox="0 0 400 {{ a._h }}" role="img" aria-label="{{ a.title }}: {{ a._parts | map(attribute='name') | join(', ') }}">{{ a._svg | safe }}</svg>
        <p class="asm-hint" aria-hidden="true"><span></span>Scroll to assemble</p>
        {%- if a.price %}<div class="asm-price"><span>{{ a.price_label or 'From' }}</span><b>{{ a.price }}</b></div>{% endif %}
      </div>
    </div>
  </div>
</section>
{%- endmacro -%}

{%- macro product_card(it) -%}
{%- set inner %}
  <div class="pc-media{% if it._art %} is-art{% endif %}{% if it._cut %} is-cut{% endif %}">
    {%- if it._cut %}<img src="{{ src(it._cut) }}" alt="{{ s.images[it._img].alt }}" loading="lazy">
    {%- elif it._img %}<img src="{{ src(it._img) }}" alt="{{ s.images[it._img].alt }}" loading="lazy">
    {%- elif it._art %}<svg viewBox="0 0 400 {{ it._art_h }}" aria-hidden="true">{{ it._art | safe }}</svg>{% endif %}
    {%- if it.badge %}<span class="pc-badge">{{ it.badge }}</span>{% endif %}
  </div>
  <div class="pc-body">
    {%- if it.category %}<span class="pc-cat">{{ it.category }}</span>{% endif %}
    <h3>{{ it.title }}</h3>
    {%- if it.text %}<p>{{ it.text }}</p>{% endif %}
    {%- if it.macros %}<ul class="pc-macros">{% for k in it.macros %}<li><b>{{ k.value }}</b>{{ k.label }}</li>{% endfor %}</ul>{% endif %}
    <div class="pc-foot">{% if it.price %}<b>{{ it.price }}</b>{% elif s.shop %}<b class="pc-ask">{{ s.shop.ask_label or 'Price on request' }}</b>{% endif %}{% if not s.shop %}<span class="pc-go">{{ icon('arrow') }}</span>{% endif %}</div>
  </div>
{%- endset %}
{%- set q = (it.title ~ ' ' ~ (it.tags or []) | join(' ') ~ ' ' ~ (it.category or '')) | lower %}
{%- if s.shop %}
<article class="pc pc-buy" data-cat="{{ it.category }}" data-q="{{ q }}">
  <a class="pc-link" href="{{ it._file }}">{{ inner }}</a>
  {%- if it._sku %}<button class="pc-add" type="button" data-add="{{ it._sku }}"{% if it.options %} data-go="{{ it._file }}"{% endif %} aria-label="Add {{ it.title }} to cart"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
  {%- else %}<a class="pc-add is-wa" href="{{ it._file }}" aria-label="Ask about {{ it.title }}">{{ icon('phone') }}</a>{% endif %}
</article>
{%- else %}
<a class="pc" href="{{ it._file }}" data-cat="{{ it.category }}" data-q="{{ q }}">{{ inner }}</a>
{%- endif %}
{%- endmacro -%}

{%- macro catalogue_strip() -%}
{%- set C = s.catalogue %}
{%- if C and C['items'] %}
<section class="cstrip">
  <div class="wrap cstrip-head">
    <div><p class="eyebrow">{{ C.nav or 'Products' }}</p><h2 class="pg-h2" data-anim="lines">{{ C.home_title or C.title }}</h2></div>
    <a class="btn btn-ghost" href="{{ C._file }}" data-magnetic>{{ C.all_label or ('All ' ~ (C.nav or 'products') | lower) }} {{ icon('arrow') }}</a>
  </div>
  <div class="cstrip-track" data-hdrag>
    {%- for it in (C['items'] | selectattr('featured') | list or C['items'][:8]) %}{{ product_card(it) }}{% endfor %}
  </div>
</section>
{%- endif %}
{%- endmacro -%}

{%- macro statement(m) -%}
<section class="stmt">
  <div class="wrap">
    {%- if m.kicker %}<p class="eyebrow">{{ m.kicker }}</p>{% endif %}
    <p class="stmt-text" data-anim="words">{{ m.text }}</p>
  </div>
</section>
{%- endmacro -%}

{%- macro stats_band() -%}
{%- if s.stats %}
<section class="pg-stats" aria-label="Key figures">
  <div class="wrap stat-grid">
    {%- for st in s.stats %}<div class="stat-tile" data-anim="up" data-delay="{{ loop.index0 * 0.08 }}"><strong>{{ count(st) }}</strong><span>{{ st.label }}</span></div>{% endfor %}
  </div>
</section>
{%- endif %}
{%- endmacro -%}

{%- macro services_grid() -%}
{%- set S = s.services %}
{%- if S and S['items'] %}
<section class="sgrid" id="services">
  <div class="wrap">
    <div class="cstrip-head">
      <div><p class="eyebrow">{{ S.nav or 'Services' }}</p><h2 class="pg-h2" data-anim="lines">{{ S.title }}</h2>{% if S.intro %}<p class="muted" data-anim="up">{{ S.intro }}</p>{% endif %}</div>
      {%- if S._file %}<a class="btn btn-ghost" href="{{ S._file }}" data-magnetic>View all {{ icon('arrow') }}</a>{% endif %}
    </div>
    <div class="sgrid-list">
      {%- for it in S['items'] %}
      <a class="sg-card" href="{{ it._file or '#' }}" data-anim="up" data-delay="{{ (loop.index0 % 3) * 0.08 }}" data-tilt>
        {%- if it._img %}<img src="{{ src(it._img) }}" alt="" loading="lazy">{% endif %}
        <span class="sg-ico">{{ icon(it.icon) }}</span>
        <span class="sg-n">{{ '%02d' % loop.index }}</span>
        <h3>{{ it.title }}</h3>
        <p>{{ it.text or it.area or (it.detail.intro if it.detail else '') }}</p>
        <span class="sg-go">{{ icon('arrow') }}</span>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}
{%- endmacro -%}

{%- macro split(m) -%}
<section class="splitf{% if m.flip %} flip{% endif %}">
  <div class="wrap splitf-grid">
    <div class="splitf-media" data-anim="wipe">{% if m.image %}<img src="{{ src(m.image) }}" alt="{{ s.images[m.image].alt }}" loading="lazy" data-speed="0.8">{% endif %}</div>
    <div class="splitf-copy">
      {%- if m.kicker %}<p class="eyebrow">{{ m.kicker }}</p>{% endif %}
      <h2 class="pg-h2" data-anim="lines">{{ m.title }}</h2>
      {%- for p in m.body or [] %}<p class="muted" data-anim="up">{{ p }}</p>{% endfor %}
      {%- if m.points %}<ul class="check-list">{% for pt in m.points %}<li data-anim="up">{{ icon('check') }}<span>{{ pt }}</span></li>{% endfor %}</ul>{% endif %}
      {%- if m.cta %}<a class="btn btn-primary" href="{{ m.cta.href }}" data-magnetic>{{ m.cta.label }} {{ icon('arrow') }}</a>{% endif %}
    </div>
  </div>
</section>
{%- endmacro -%}

{%- macro emi() -%}
{%- set E = s.emi or {} %}
<section class="tool" id="tools">
  <div class="wrap tool-grid">
    <div>
      <p class="eyebrow">{{ E.kicker or 'Calculator' }}</p>
      <h2 class="pg-h2" data-anim="lines">{{ E.title or 'Estimate your monthly instalment' }}</h2>
      <p class="muted" data-anim="up">{{ E.note or 'An estimate only, worked out on your device. Your actual rate and instalment depend on approval.' }}</p>
    </div>
    <form class="bmi emi" data-emi data-cur="{{ E.currency or '' }}" novalidate>
      <label>Amount <span><input type="range" name="p" min="{{ E.min or 1000 }}" max="{{ E.max or 100000 }}" step="{{ E.step or 500 }}" value="{{ E.value or 20000 }}"><output data-o="p"></output></span></label>
      <label>Rate (% a year) <span><input type="range" name="r" min="1" max="15" step="0.25" value="{{ E.rate or 6 }}"><output data-o="r"></output></span></label>
      <label>Term (months) <span><input type="range" name="n" min="6" max="{{ E.max_months or 120 }}" step="6" value="{{ E.months or 48 }}"><output data-o="n"></output></span></label>
      <div class="bmi-out">
        <p class="bmi-band">Monthly instalment</p>
        <div class="emi-v"><strong data-emi-v>0</strong></div>
        <p class="bmi-note" data-emi-total></p>
        <a class="btn btn-primary btn-sm" href="{{ E.href or 'contact.html' }}">{{ E.cta or 'Apply now' }} {{ icon('arrow') }}</a>
      </div>
    </form>
  </div>
</section>
{%- endmacro -%}

{%- macro partners() -%}
{%- set P = s.partners or s.insurance %}
{%- if P %}
<section class="ins" aria-label="{{ P.title or 'Partners' }}">
  <div class="wrap ins-head"><p class="eyebrow">{{ P.kicker or 'Partners' }}</p><h2 class="pg-h2" data-anim="lines">{{ P.intro }}</h2></div>
  {%- set half = (P.partners | length / 2) | round(0, 'ceil') | int %}
  {%- for row, dir in [(P.partners[:half], 'left'), (P.partners[half:], 'right')] %}
  <div class="marquee ins-row" data-marquee="0.6" data-dir="{{ dir }}"><div class="marquee-track" aria-hidden="true">{% for pass in [0, 1] %}<div class="marquee-group">{% for p in row %}<span class="ins-chip">{{ p }}</span>{% endfor %}</div>{% endfor %}</div></div>
  {%- endfor %}
  <p class="visually-hidden">{{ P.partners | join(', ') }}</p>
</section>
{%- endif %}
{%- endmacro -%}

{%- macro locations_block() -%}
{%- if s.locations and s.locations['items'] %}
<section class="pg-section countries" id="locations">
  <div class="wrap">
    <div class="cstrip-head"><div><p class="eyebrow">{{ s.locations.nav or 'Locations' }}</p><h2 class="pg-h2" data-anim="lines">{{ s.locations.title }}</h2></div>
    <a class="btn btn-ghost" href="{{ s.locations._file }}" data-magnetic>All {{ (s.locations.nav or 'locations') | lower }} {{ icon('arrow') }}</a></div>
    {{ curve() }}
  </div>
</section>
{%- endif %}
{%- endmacro -%}

{%- macro module(m) -%}
{#- Renders one home-page section by type. The studio theme loops over s.home. -#}
{%- set t = m.type if m is mapping else m %}
{%- if t == 'promo' %}{% if s.promos %}{{ promo() }}{% endif %}
{%- elif t == 'rail' %}{{ rail() }}
{%- elif t == 'statement' %}{% if m is mapping and m.text %}{{ statement(m) }}{% endif %}
{%- elif t == 'stats' %}{{ stats_band() }}
{%- elif t == 'services' %}{{ services_grid() }}
{%- elif t == 'catalogue' %}{{ catalogue_strip() }}
{%- elif t == 'assemble' %}{% for a in s.assemble or [] if (m is not mapping or not m.id or a.id == m.id) %}{{ assemble(a) }}{% endfor %}
{%- elif t == 'converge' %}{{ converge(m) }}
{%- elif t == 'stack' %}{{ stack(m) }}
{%- elif t == 'lineup' %}{{ lineup(m) }}
{%- elif t == 'split' %}{% if m is mapping and m.title %}{{ split(m) }}{% endif %}
{%- elif t == 'news' %}{{ home_news() }}
{%- elif t == 'testimonials' %}{{ testimonials() }}
{%- elif t == 'partners' %}{{ partners() }}
{%- elif t == 'locations' %}{{ locations_block() }}
{%- elif t == 'faq' %}{{ faq() }}
{%- elif t == 'bmi' %}{{ bmi() }}
{%- elif t == 'emi' %}{{ emi() }}
{%- elif t == 'scrub' %}{{ scrub(m) }}
{%- elif t == 'depth' %}{{ depth(m) }}
{%- elif t == 'stages' %}{{ stages(m) }}
{%- endif %}
{%- endmacro -%}

{%- macro scrub(m) -%}
{#- Scroll-scrubbed footage: a video (encoded with tools/encode.sh) or an image sequence
    (tools/frames.sh) advances with the scroll while text beats change over it. -#}
{%- set H = m.height or 300 %}
<section class="scrub" id="{{ m.id or 'scrub' }}" data-scrub style="--scrub-h: {{ H }}vh" aria-label="{{ m.label or (m.beats[0].title if m.beats else 'Film') }}">
  <div class="scrub-stage">
    {%- if m.poster %}<img class="scrub-poster" src="{{ src(m.poster) }}" alt="" aria-hidden="true">{% endif %}
    {%- if m.video %}
    <video class="scrub-media" muted playsinline preload="auto" data-src="assets/media/{{ m.video }}"{% if m.video_m %} data-src-m="assets/media/{{ m.video_m }}"{% endif %}{% if m.poster %} poster="{{ src(m.poster) }}"{% endif %}></video>
    {%- elif m.frames %}
    <canvas class="scrub-media" data-frames="assets/media/{{ m.frames.dir }}/" data-count="{{ m.frames.count }}" data-ext="{{ m.frames.ext or 'webp' }}" data-pad="{{ m.frames.pad or 3 }}"></canvas>
    {%- endif %}
    <div class="scrub-shade" aria-hidden="true"></div>
    <div class="wrap scrub-beats scrub-{{ m.align or 'left' }}">
      {%- for b in m.beats or [] %}
      <div class="scrub-beat" data-at="{{ b.at if b.at is defined else (loop.index0 / loop.length) }}">
        {%- if b.kicker %}<p class="eyebrow">{{ b.kicker }}</p>{% endif %}
        {%- if b.title %}<h2 class="scrub-title">{{ b.title }}</h2>{% endif %}
        {%- if b.text %}<p class="scrub-text">{{ b.text }}</p>{% endif %}
        {%- if b.cta %}<a class="btn btn-primary" href="{{ b.cta.href }}">{{ b.cta.label }} {{ icon('arrow') }}</a>{% endif %}
      </div>
      {%- endfor %}
    </div>
    <div class="scrub-bar" aria-hidden="true"><i></i></div>
  </div>
</section>
{%- endmacro -%}

{%- macro depth(m) -%}
{#- Layered hero: independent planes (sky, subject, foreground, generated clouds) move at different
    rates as you scroll and lean with the pointer; the headline can sit between planes. -#}
<section class="depth" id="{{ m.id or 'depth' }}" data-depth style="--depth-h: {{ m.height or 200 }}vh">
  <div class="depth-stage">
    {%- for l in m.layers %}
    {%- if l.clouds %}
    <div class="depth-layer depth-clouds{% if l.front %} is-front{% endif %}" data-speed="{{ l.speed or 0.6 }}" data-lean="{{ l.lean or 18 }}" style="--tint: {{ l.tint or '#ffffff' }}; z-index: {{ l.z or (loop.index * 10) }}; --cy: {{ l.y or 70 }}%" aria-hidden="true">
      {%- for k in range(l.count or 9) %}<i style="--x: {{ (k * 37 + 7) % 100 }}%; --y: {{ (k * 23 + 11) % 34 }}%; --s: {{ 0.7 + (k % 4) * 0.25 }}; --d: {{ 40 + (k % 5) * 14 }}s; --o: {{ 0.55 + (k % 3) * 0.15 }}"></i>{% endfor %}
    </div>
    {%- elif l.title %}
    <div class="depth-layer depth-copy" data-speed="{{ l.speed or 0.35 }}" data-fade="1" style="z-index: {{ l.z or (loop.index * 10) }}">
      <div class="wrap">
        {%- if m.kicker %}<p class="eyebrow">{{ m.kicker }}</p>{% endif %}
        <h1 class="depth-title">{{ m.title }}</h1>
        {%- if m.text %}<p class="depth-text">{{ m.text }}</p>{% endif %}
        {%- if m.cta %}<a class="btn btn-primary" href="{{ m.cta.href }}" data-magnetic>{{ m.cta.label }} {{ icon('arrow') }}</a>{% endif %}
      </div>
    </div>
    {%- else %}
    <div class="depth-layer{% if l.mask %} mask-{{ l.mask }}{% endif %}" data-speed="{{ l.speed or 0.2 }}" data-scale="{{ l.scale or 0 }}" data-lean="{{ l.lean or 8 }}" style="z-index: {{ l.z or (loop.index * 10) }}{% if l.inset %}; inset: {{ l.inset }}{% endif %}">
      <img src="{{ src(l.image) }}" alt="{{ s.images[l.image].alt if l.alt is not defined else l.alt }}" style="object-position: {{ l.position or 'center' }}; {% if l.fit == 'contain' %}object-fit: contain;{% endif %}{% if l.bottom %} top: auto; bottom: 0; height: {{ l.bottom }};{% endif %}">
    </div>
    {%- endif %}
    {%- endfor %}
    {%- if m.cap %}<span class="depth-cap">{{ m.cap }}</span>{% endif %}
  </div>
</section>
{%- endmacro -%}



{%- macro converge(m) -%}
{#- Real ingredients (cut-out photos) float around the frame and fly into the dish as you scroll;
    the dish settles, then its numbers appear around it. Reduced motion: the finished scene. -#}
{%- set it = (s.catalogue['items'] | selectattr('title', 'equalto', m.product) | first) if m.product else none %}
<section class="cv" id="{{ m.id or 'converge' }}" data-converge style="--cv-h: {{ m.height or 240 }}vh">
  <div class="cv-stage">
    <div class="cv-bg" aria-hidden="true"><i></i></div>
    <div class="wrap cv-copy">
      {%- if m.kicker %}<p class="eyebrow">{{ m.kicker }}</p>{% endif %}
      <h1 class="cv-title">{{ m.title | safe }}</h1>
      {%- if m.text %}<p class="cv-text">{{ m.text }}</p>{% endif %}
      <div class="cta-row">{% if m.cta %}<a class="btn btn-primary" href="{{ m.cta.href }}" data-magnetic>{{ m.cta.label }} {{ icon('arrow') }}</a>{% endif %}{% if m.cta2 %}<a class="btn btn-ghost" href="{{ m.cta2.href }}">{{ m.cta2.label }}</a>{% endif %}</div>
    </div>
    <div class="cv-scene">
      <div class="cv-plate">
        <span class="cv-shadow" aria-hidden="true"></span>
        <img class="cv-dish" src="{{ src(m.dish) }}" alt="{{ s.images[m.dish].alt }}">
        {%- for c in m.chips or [] %}<span class="cv-chip" style="--a: {{ c.angle or (loop.index0 * 90 - 45) }}deg"><b>{{ c.value }}</b>{{ c.label }}</span>{% endfor %}
      </div>
      {%- for g in m.ingredients %}
      <img class="cv-ing" src="{{ src(g.image) }}" alt="" aria-hidden="true" data-x="{{ g.x }}" data-y="{{ g.y }}" data-r="{{ g.rot or 0 }}" data-z="{{ g.z or 0.5 }}" style="--w: {{ g.size or 120 }}px; --sx: {{ g.x }}; --sy: {{ g.y }}">
      {%- endfor %}
    </div>
    {%- if it %}
    <div class="cv-buy">
      <a class="cv-buy-t" href="{{ it._file }}"><span>{{ it.category }}</span><b>{{ it.title }}</b></a>
      {%- if it.price %}<span class="cv-buy-p">{{ it.price }}</span>{% endif %}
      {%- if it._sku %}<button class="btn btn-primary btn-sm" type="button" data-add="{{ it._sku }}">{{ s.shop.add_label or 'Add to order' }}</button>{% endif %}
    </div>
    {%- endif %}
    {%- if m.cap %}<span class="cv-cap">{{ m.cap }}</span>{% endif %}
    <span class="cv-hint" aria-hidden="true"><i></i>Scroll</span>
  </div>
</section>
{%- endmacro -%}

{%- macro stack(m) -%}
{#- Exploded product made of real photographed layers (cut-outs), bottom layer first. It starts
    assembled, opens as you scroll with each layer named, then closes again. -#}
{%- set it = (s.catalogue['items'] | selectattr('title', 'equalto', m.product) | first) if m.product else none %}
<section class="stk" id="{{ m.id or 'stack' }}" data-stack style="--stk-h: {{ m.height or 300 }}vh">
  <div class="stk-stage">
    <div class="wrap stk-grid">
      <div class="stk-copy">
        {%- if m.kicker %}<p class="eyebrow">{{ m.kicker }}</p>{% endif %}
        <h2 class="stk-title">{{ m.title | safe }}</h2>
        {%- if m.intro %}<p class="stk-intro">{{ m.intro }}</p>{% endif %}
        <ol class="stk-list">
          {%- for l in m.layers | reverse %}<li data-i="{{ m.layers | length - loop.index }}"><b>{{ l.name }}</b>{% if l.note %}<span>{{ l.note }}</span>{% endif %}</li>{% endfor %}
        </ol>
        {%- if it %}<div class="stk-buy">{% if it.price %}<b>{{ it.price }}</b>{% else %}<b class="pc-ask">{{ s.shop.ask_label if s.shop else '' }}</b>{% endif %}<a class="btn btn-primary btn-sm" href="{{ it._file }}">{{ m.cta_label or 'See it' }} {{ icon('arrow') }}</a></div>{% endif %}
      </div>
      <div class="stk-view" style="--stk-w: {{ m.width or 78 }}%">
        <span class="stk-shadow" aria-hidden="true"></span>
        {%- for l in m.layers %}
        <figure class="stk-l" data-i="{{ loop.index0 }}" data-t="{{ l.t or 10 }}" data-dx="{{ l.dx or 0 }}" data-rot="{{ l.rot or 0 }}" style="--lw: {{ l.w or 78 }}%; --i: {{ loop.index0 }}; z-index: {{ loop.index }}"><img src="{{ src(l.image) }}" alt="{{ l.name }}"><figcaption>{{ l.name }}</figcaption></figure>
        {%- endfor %}
      </div>
    </div>
    {%- if m.cap %}<span class="cv-cap">{{ m.cap }}</span>{% endif %}
  </div>
</section>
{%- endmacro -%}

{%- macro lineup(m) -%}
{#- The lineup: real cut-out products in a row that slides sideways as you scroll (swipe on phones). -#}
{%- set C = s.catalogue %}
{%- set picks = [] %}{% for t in m['items'] or [] %}{% for it in C['items'] if it.title == t %}{% set _ = picks.append(it) %}{% endfor %}{% endfor %}
{%- set picks = picks or (C['items'] | selectattr('featured') | list) %}
<section class="lu" id="{{ m.id or 'lineup' }}" data-lineup>
  <div class="lu-stage">
    <div class="wrap lu-head">
      <h2 class="lu-title">{{ m.title or 'The lineup.' }}</h2>
      {%- if m.text %}<p class="lu-text">{{ m.text }}</p>{% endif %}
    </div>
    <div class="lu-track" data-lu-track>
      {%- for it in picks %}
      <article class="lu-item">
        <a class="lu-img" href="{{ it._file }}"><img src="{{ src(it._cut or it._img) }}" alt="{{ s.images[it._img].alt }}" loading="lazy" draggable="false"></a>
        <p class="lu-cat">{{ it.category }}</p>
        <h3 class="lu-name"><a href="{{ it._file }}">{{ it.title }}</a></h3>
        {%- if it.macros %}<p class="lu-mac">{% for k in it.macros %}{{ k.value }} {{ k.label }}{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
        <div class="lu-foot">{% if it.price %}<b>{{ it.price }}</b>{% else %}<b class="pc-ask">{{ s.shop.ask_label if s.shop else '' }}</b>{% endif %}
          {%- if it._sku %}<button class="pc-add lu-add" type="button" data-add="{{ it._sku }}" aria-label="Add {{ it.title }}"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>{% endif %}</div>
      </article>
      {%- endfor %}
      <a class="lu-more" href="{{ C._file }}"><span>{{ m.more or 'Full menu' }}</span>{{ icon('arrow') }}</a>
    </div>
  </div>
</section>
{%- endmacro -%}

{%- macro stages(m) -%}
{#- Storyline of stills (renders, construction progress, process steps) that wipe from one to the
    next as you scroll, with a progress rail of labelled stages. -#}
<section class="stages" id="{{ m.id or 'stages' }}" data-stages style="--stages-n: {{ m.stages | length }}">
  <div class="stages-stage">
    {%- for st in m.stages %}
    <figure class="stg-img" data-i="{{ loop.index0 }}"><img src="{{ src(st.image) }}" alt="{{ s.images[st.image].alt }}" loading="lazy"></figure>
    {%- endfor %}
    <div class="stages-shade" aria-hidden="true"></div>
    <div class="wrap stages-copy">
      {%- if m.kicker %}<p class="eyebrow">{{ m.kicker }}</p>{% endif %}
      {%- if m.title %}<h2 class="stages-title">{{ m.title }}</h2>{% endif %}
      <div class="stg-texts">
        {%- for st in m.stages %}
        <div class="stg-text" data-i="{{ loop.index0 }}"><span class="stg-n">{{ '%02d' % loop.index }}{% if st.date %} · {{ st.date }}{% endif %}</span><h3>{{ st.title or st.label }}</h3>{% if st.text %}<p>{{ st.text }}</p>{% endif %}</div>
        {%- endfor %}
      </div>
    </div>
    <ol class="stg-rail">
      {%- for st in m.stages %}<li data-i="{{ loop.index0 }}"><i></i><span>{{ st.label }}</span></li>{% endfor %}
      <b class="stg-fill" aria-hidden="true"></b>
    </ol>
  </div>
</section>
{%- endmacro -%}
