{#- Glass anatomy: animated SVG illustrations drawn for the Badr Al Samaa concept.
    defs() goes once per page; body() is the hero figure; organ(kind) draws one centre's visual.
    All motion is CSS (shared/css/story.css), so it pauses offscreen and stops for reduced motion. -#}

{%- macro defs() -%}
<svg class="svg-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="g-glass" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity=".55"/>
      <stop offset=".45" stop-color="#bfeee8" stop-opacity=".14"/>
      <stop offset="1" stop-color="#0f5c55" stop-opacity=".42"/>
    </linearGradient>
    <linearGradient id="g-edge" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity=".95"/>
      <stop offset="1" stop-color="#9fe3da" stop-opacity=".35"/>
    </linearGradient>
    <radialGradient id="g-organ" cx=".35" cy=".3" r=".85">
      <stop offset="0" stop-color="#ffe0d6"/>
      <stop offset=".45" stop-color="#ef8a6d" stop-opacity=".92"/>
      <stop offset="1" stop-color="#a3301f" stop-opacity=".75"/>
    </radialGradient>
    <radialGradient id="g-bone" cx=".4" cy=".3" r=".9">
      <stop offset="0" stop-color="#ffffff" stop-opacity=".95"/>
      <stop offset="1" stop-color="#cfe9e4" stop-opacity=".3"/>
    </radialGradient>
    <linearGradient id="g-scan" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#7ff0e0" stop-opacity="0"/>
      <stop offset=".5" stop-color="#7ff0e0" stop-opacity=".6"/>
      <stop offset="1" stop-color="#7ff0e0" stop-opacity="0"/>
    </linearGradient>
    <radialGradient id="g-halo" cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#7ff0e0" stop-opacity=".45"/>
      <stop offset="1" stop-color="#7ff0e0" stop-opacity="0"/>
    </radialGradient>
    <filter id="f-glow" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="2.4" result="b"/>
      <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
    <clipPath id="clip-tooth"><path d="M64 58 C60 38 84 32 100 42 C116 32 140 38 136 58 C134 78 128 90 124 118 C122 138 118 166 110 166 C104 166 104 138 100 126 C96 138 96 166 90 166 C82 166 78 138 76 118 C72 90 66 78 64 58 Z"/></clipPath>
    <clipPath id="clip-body"><path d="M150 104 L166 104 C170 116 190 122 212 128 C230 134 236 150 238 176 L246 260 C248 290 254 320 258 350 C262 370 264 386 258 398 C252 404 244 398 242 388 L236 356 C230 330 222 300 220 270 L212 196 C208 230 202 270 200 300 C206 326 210 350 208 380 C206 420 200 460 198 490 C196 530 192 570 190 600 C192 612 200 622 198 630 L102 630 C100 622 108 612 110 600 C108 570 104 530 102 490 C100 460 94 420 92 380 C90 350 94 326 100 300 C98 270 92 230 88 196 L80 270 C78 300 70 330 64 356 L58 388 C56 398 48 404 42 398 C36 386 38 370 42 350 C46 320 52 290 54 260 L62 176 C64 150 70 134 88 128 C110 122 130 116 134 104 Z M150 18 A34 42 0 1 1 149.9 18 Z"/></clipPath>
  </defs>
</svg>
{%- endmacro -%}

{#- ---------- hero: glass body with skeleton, organs, scan beam ---------- -#}
{%- macro body() -%}
{%- set half = "M150 104 L166 104 C170 116 190 122 212 128 C230 134 236 150 238 176 L246 260 C248 290 254 320 258 350 C262 370 264 386 258 398 C252 404 244 398 242 388 L236 356 C230 330 222 300 220 270 L212 196 C208 230 202 270 200 300 C206 326 210 350 208 380 C206 420 200 460 198 490 C196 530 192 570 190 600 C192 612 200 622 198 630 L164 630 C160 610 162 590 162 570 C160 520 158 460 156 420 C155 400 153 388 150 384" -%}
<svg class="glass-body" viewBox="0 0 300 640" role="img" aria-label="Animated glass figure showing the skeleton and organs">
  <ellipse class="body-halo" cx="150" cy="300" rx="150" ry="300" fill="url(#g-halo)"/>
  {#- glass skin -#}
  <g class="skin">
    <path class="gl" d="{{ half }} Z" stroke="none"/>
    <path class="gl" d="{{ half }} Z" stroke="none" transform="translate(300 0) scale(-1 1)"/>
    <ellipse class="gl" cx="150" cy="60" rx="34" ry="42" stroke="none"/>
    <path class="edge" d="{{ half }}"/>
    <path class="edge" d="{{ half }}" transform="translate(300 0) scale(-1 1)"/>
    <ellipse class="edge" cx="150" cy="60" rx="34" ry="42"/>
    <path class="hl" d="M126 34 C132 24 142 20 150 20"/>
    <path class="hl" d="M92 140 C80 150 72 166 70 186"/>
  </g>
  {#- skeleton -#}
  <g class="skeleton">
    <ellipse class="bnl" cx="150" cy="56" rx="25" ry="30"/>
    <path class="bnl" d="M136 82 C140 92 160 92 164 82"/>
    {%- for i in range(27) %}<rect class="vert" x="146" y="{{ 104 + i * 10 }}" width="8" height="6" rx="2"/>{% endfor %}
    {%- for i in range(7) %}
    {%- set y = 146 + i * 14 %}
    <path class="rib" d="M150 {{ y }} C130 {{ y - 6 }} {{ 108 + i }} {{ y + 2 }} {{ 108 + i * 2 }} {{ y + 18 }}"/>
    <path class="rib" d="M150 {{ y }} C170 {{ y - 6 }} {{ 192 - i }} {{ y + 2 }} {{ 192 - i * 2 }} {{ y + 18 }}"/>
    {%- endfor %}
    <path class="bnl" d="M150 132 L100 138 M150 132 L200 138"/>
    <path class="bnl" d="M120 352 C110 372 120 396 150 393 C180 396 190 372 180 352 C170 364 130 364 120 352 Z"/>
    <path class="bnl" d="M222 142 L234 256 M236 262 L250 352 M78 142 L66 256 M64 262 L50 352"/>
    <path class="bnl" d="M178 392 L186 478 M186 494 L184 600 M122 392 L114 478 M114 494 L116 600"/>
    <circle class="bnl" cx="186" cy="486" r="7"/>
    <circle class="bnl" cx="114" cy="486" r="7"/>
  </g>
  {#- organs -#}
  <g class="organs">
    <path class="or o-brain" d="M130 52 C128 38 142 32 150 36 C158 32 172 38 170 52 C172 64 160 70 150 66 C140 70 128 64 130 52 Z"/>
    <path class="or o-lung" d="M146 152 C122 150 110 180 112 212 C114 234 136 238 144 224 Z" opacity=".45"/>
    <path class="or o-lung" d="M154 152 C178 150 190 180 188 212 C186 234 164 238 156 224 Z" opacity=".45"/>
    <path class="or o-heart" d="M158 214 C146 206 140 196 144 188 C147 182 154 182 158 188 C162 182 170 182 172 188 C176 198 168 206 158 214 Z"/>
    <path class="or o-liver" d="M112 238 C122 228 150 228 156 240 C150 256 126 264 114 254 Z" opacity=".6"/>
    <path class="or o-stomach" d="M160 236 C176 230 192 238 190 254 C188 268 170 270 162 262 C168 254 166 246 160 236 Z"/>
    <path class="gut o-gut" d="M126 286 C126 276 174 276 174 286 C174 296 126 296 126 306 C126 316 174 316 174 326"/>
    <path class="or o-kidney" d="M126 272 C118 274 116 288 122 294 C126 290 128 282 126 272 Z" opacity=".7"/>
    <path class="or o-kidney" d="M174 272 C182 274 184 288 178 294 C174 290 172 282 174 272 Z" opacity=".7"/>
    <path class="or o-womb" d="M138 346 C138 336 162 336 162 346 C162 360 154 366 150 366 C146 366 138 360 138 346 Z"/>
  </g>
  {#- scan beam, clipped to the figure -#}
  <g clip-path="url(#clip-body)">
    <rect class="body-scan" x="0" y="-60" width="300" height="70" fill="url(#g-scan)"/>
  </g>
</svg>
{%- endmacro -%}

{#- ---------- one organ per centre (viewBox 0 0 200 200) ---------- -#}
