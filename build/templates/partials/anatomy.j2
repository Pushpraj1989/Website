    <path class="hl" d="M93 14 L93 80"/>
  </g>
  <ellipse class="gl patella" cx="100" cy="104" rx="11" ry="14"/>
  <ellipse class="cartilage" cx="100" cy="122" rx="24" ry="4"/>
  <g class="tibia">
    <path class="bn" d="M78 132 C84 125 116 125 122 132 L113 144 L111 194 L89 194 L87 144 Z"/>
