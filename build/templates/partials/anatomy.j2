    <path class="tube" d="M92 66 C88 42 100 28 118 30 C130 32 136 44 130 56"/>
    <path class="tube" d="M80 64 C72 48 60 42 50 46"/>
    <path class="tube" d="M112 60 C118 46 130 40 142 44"/>
    <path class="gl" d="M100 172 C60 152 40 118 48 88 C54 64 76 54 92 64 C98 52 112 46 124 50 C148 58 160 86 152 112 C144 140 122 160 100 172 Z"/>
    <path class="or" d="M100 160 C72 144 58 118 64 96 C68 80 82 74 94 82 C100 74 110 72 118 76 C136 82 144 102 138 120 C132 140 116 152 100 160 Z"/>
    <path class="vein" d="M100 84 C106 104 96 124 104 150"/>
    <path class="vein" d="M120 82 C130 100 128 120 118 138"/>
    <path class="hl" d="M58 96 C60 80 72 70 86 72"/>
  </g>
  <polyline class="ecg" points="8,188 56,188 66,188 74,170 82,198 90,178 98,188 136,188 146,188 154,174 160,196 166,188 192,188"/>
{%- elif kind == 'knee' %}
