{% extends "base.html.j2" %}
{% import "partials/macros.j2" as m with context %}
{% block content %}
{%- set it = page.item %}{% set C = s.catalogue %}
<section class="pd-hero" id="top">
  <div class="wrap pd-grid">
    <div class="pd-media{% if it._art and not it._img %} is-art{% endif %}{% if it._cut %} is-cut{% endif %}" data-anim="scale">
      {%- if it._cut %}<span class="pd-halo" aria-hidden="true"></span><img class="pd-cut" src="{{ m.src(it._cut) }}" alt="{{ s.images[it._img].alt }}">
      {%- if it.macros %}{% for k in it.macros %}<span class="pd-orb" style="--i: {{ loop.index0 }}"><b>{{ k.value }}</b>{{ k.label }}</span>{% endfor %}{% endif %}
      {%- elif it._img %}<img src="{{ m.src(it._img) }}" alt="{{ s.images[it._img].alt }}">
      {%- elif it._art %}<svg viewBox="0 0 400 {{ it._art_h }}" role="img" aria-label="{{ it.title }}">{{ it._art | safe }}</svg>{% endif %}
      <div class="pd-orbit" aria-hidden="true"></div>
    </div>
    <div class="pd-copy">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="index.html">Home</a><span>/</span><a href="{{ page.listing }}">{{ page.label }}</a><span>/</span><span aria-current="page">{{ it.title }}</span></nav>
      {%- if it.category %}<p class="eyebrow">{{ it.category }}</p>{% endif %}
      <h1 class="pd-title" data-anim="lines" data-intro>{{ it.title }}</h1>
      {%- if it.text %}<p class="pd-text" data-anim="up" data-intro>{{ it.text }}</p>{% endif %}
      {%- if it.price %}<p class="pd-price" data-anim="up" data-intro><b>{{ it.price }}</b>{% if it.price_note %}<span>{{ it.price_note }}</span>{% endif %}</p>{% endif %}
      {%- if it.options %}
      <div class="pd-opts" data-anim="up" data-intro>
        {%- for o in it.options %}<div class="pd-opt"><span>{{ o.label }}</span><div class="pd-chips">{% for v in o['values'] %}<button type="button" class="pd-chip{% if loop.first %} is-on{% endif %}" data-chip>{{ v }}</button>{% endfor %}</div></div>{% endfor %}
      </div>
      {%- endif %}
      {%- if s.shop %}
      <div class="cta-row buy-row" data-anim="up" data-intro>
        {%- if it._sku %}
        <div class="qty" data-qty><button type="button" data-step="-1" aria-label="One less">&minus;</button><output>1</output><button type="button" data-step="1" aria-label="One more">+</button></div>
        <button class="btn btn-primary" type="button" data-add="{{ it._sku }}" data-from-page data-magnetic>{{ s.shop.add_label or 'Add to order' }} {{ icon('arrow') }}</button>
        {%- elif s._shop.wa %}
        <a class="btn btn-primary" href="https://wa.me/{{ s._shop.wa | replace('+', '') }}?text={{ ('Hello ' ~ s.short ~ ', I would like to order: ' ~ it.title) | urlencode }}" target="_blank" rel="noopener" data-magnetic>Order on WhatsApp {{ icon('arrow') }}</a>
        {%- else %}
        <a class="btn btn-primary" href="contact.html" data-magnetic>Ask about this item {{ icon('arrow') }}</a>
        {%- endif %}
      </div>
      {%- if not it._sku %}<p class="buy-note">{{ s.shop.ask_note or 'Priced when you choose options. Ask us and we will confirm the price.' }}</p>{% endif %}
      {%- else %}
      <div class="cta-row" data-anim="up" data-intro>
        <a class="btn btn-primary" href="{{ it.cta.href if it.cta else 'contact.html' }}" data-magnetic>{{ it.cta.label if it.cta else (C.cta or s.cta.label) }} {{ icon('arrow') }}</a>
        {%- if C.compare %}<a class="btn btn-ghost" href="compare.html">Compare</a>{% endif %}
      </div>
      {%- endif %}
      {%- if it.tags %}<ul class="spec-chips pd-tags">{% for t in it.tags %}<li><span>{{ t }}</span></li>{% endfor %}</ul>{% endif %}
    </div>
  </div>
</section>
{%- if it.specs or it.nutrition or it.body %}
<section class="pg-section">
  <div class="wrap detail-grid">
    <div class="prose">
      {%- for p in it.body or [] %}<p data-anim="up">{{ p }}</p>{% endfor %}
      {%- if it.specs %}
      <h2 class="pg-h3" data-anim="up">{{ C.specs_title or 'Details' }}</h2>
      <dl class="facts">{% for f in it.specs %}<div data-anim="up"><dt>{{ f.label }}</dt><dd>{{ f.value }}</dd></div>{% endfor %}</dl>
      {%- endif %}
    </div>
    {%- if it.nutrition %}
    <aside class="nutri" data-anim="up">
      <p class="side-h">{{ C.nutrition_title or 'Nutrition' }}{% if it.serving %} · {{ it.serving }}{% endif %}</p>
      {%- for n in it.nutrition %}
      <div class="nutri-row"><span>{{ n.label }}</span><b>{{ n.value }}</b>{% if n.pct %}<i style="--p: {{ n.pct }}"></i>{% endif %}</div>
      {%- endfor %}
    </aside>
    {%- endif %}
  </div>
</section>
{%- endif %}
{%- if it.gallery %}
<section class="pd-gallery" aria-label="Gallery">
  <div class="wrap cstrip-head"><div><p class="eyebrow">Gallery</p><h2 class="pg-h2" data-anim="lines">{{ it.gallery_title or 'Inside ' ~ it.title }}</h2></div></div>
  <div class="pdg-track" data-hdrag>
    {%- for g in it.gallery %}<figure class="pdg-item"><img src="{{ m.src(g) }}" alt="{{ s.images[g].alt }}" loading="lazy" draggable="false">{% if s.images[g].cap %}<figcaption>{{ s.images[g].cap }}</figcaption>{% endif %}</figure>{% endfor %}
  </div>
</section>
{%- endif %}
{%- if it.highlights %}
<section class="pg-section">
  <div class="wrap">
    <p class="eyebrow">{{ C.highlights_title or 'Highlights' }}</p>
    <div class="point-grid">{% for h in it.highlights %}<article class="point-card" data-anim="up" data-delay="{{ (loop.index0 % 3) * 0.08 }}"><span class="point-n">{{ '%02d' % loop.index }}</span><h3>{{ h.title }}</h3>{% if h.text %}<p>{{ h.text }}</p>{% endif %}</article>{% endfor %}</div>
  </div>
</section>
{%- endif %}
{%- for a in s.assemble or [] if a.product == it.title %}{{ m.assemble(a) }}{% endfor %}
<section class="pg-section alt">
  <div class="wrap">
    <p class="eyebrow">You may also like</p>
    <div class="pc-grid">
      {%- set rel = C['items'] | selectattr('category', 'equalto', it.category) | rejectattr('title', 'equalto', it.title) | list %}
      {%- for o in (rel or C['items'])[:3] %}{{ m.product_card(o) }}{% endfor %}
    </div>
  </div>
</section>
{% endblock %}
