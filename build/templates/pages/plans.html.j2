{% extends "base.html.j2" %}
{% import "partials/macros.j2" as m with context %}
{% block content %}
{%- set PL = s.shop.plans %}
{%- set hero_img = PL.image or ('hero' if 'hero' in s.images else none) %}
{%- set kicker = PL.kicker or PL.nav or 'Meal plans' %}{% set intro = PL.intro %}{% set crumb = PL.nav or 'Meal plans' %}
{% include "partials/pagehero.html.j2" %}
{%- if PL.mode == 'subscription' %}
{%- macro money(a) %}{{ s.shop.currency }} {{ '%.3f' % a }}{% endmacro %}
<section class="pg-section alt msub-builder" data-plan data-sub>
  <div class="wrap msub-grid">
    <div class="msub-stage" aria-hidden="true">
      <div class="msub-glow"></div>
      {%- for ml in PL.meals %}<img class="msub-box{% if loop.first %} is-on{% endif %}" data-sub-img="{{ ml.n }}" src="{{ m.src('cut:' ~ ml.image) }}" alt="" loading="{{ 'eager' if loop.first else 'lazy' }}">{% endfor %}
      <p class="msub-count"><b data-sub-n>{{ PL.meals[0].n }}</b><span>meal{{ '' if PL.meals[0].n == 1 else 's' }} a day</span></p>
    </div>
    <form class="plan-form msub-form" data-plan-form novalidate>
      <p class="eyebrow">{{ PL.product }}</p>
      <h2 class="pg-h2" data-anim="lines">{{ PL.builder_title or 'Build your subscription' }}</h2>
      <fieldset class="co-step"><legend><span class="co-n">1</span>How long</legend>
        <div class="seg">{% for p in PL.periods %}<label class="seg-opt"><input type="radio" name="period" value="{{ p.key }}" data-days="{{ p.days }}" data-label="{{ p.label }} ({{ p.sub }})"{% if loop.first %} checked{% endif %}><span><b>{{ p.label }}</b><small>{{ p.sub }}</small></span></label>{% endfor %}</div>
      </fieldset>
      <fieldset class="co-step"><legend><span class="co-n">2</span>Meals a day</legend>
        <div class="seg">{% for ml in PL.meals %}<label class="seg-opt"><input type="radio" name="meals" value="{{ ml.n }}"{% if loop.first %} checked{% endif %}><span><b>{{ ml.n }} meal{{ '' if ml.n == 1 else 's' }}</b><small data-sub-from="{{ ml.n }}"></small></span></label>{% endfor %}</div>
      </fieldset>
      {%- if PL.addons %}
      <fieldset class="co-step"><legend><span class="co-n">3</span>Add-ons <i>(optional)</i></legend>
        <div class="msub-addons">{% for a in PL.addons %}<label class="plan-pick msub-addon"><input type="checkbox" name="addon" value="{{ a.label }}"><span class="pp-t"><b>{{ a.label }}</b><small>{{ a.price }}</small></span></label>{% endfor %}</div>
        <p class="co-hint">{{ PL.addon_note }}</p>
      </fieldset>
      {%- endif %}
      <fieldset class="co-step"><legend><span class="co-n">{{ 4 if PL.addons else 3 }}</span>Start</legend>
        <div class="co-fields">
          <label class="fld"><span>Start date</span><input type="date" name="start" data-sub-start required></label>
          <label class="fld"><span>Notes <i>(optional)</i></span><input name="notes" maxlength="40" placeholder="Allergies, dislikes"></label>
        </div>
      </fieldset>
      <p class="co-error" data-co-error role="alert" hidden></p>
      <div class="msub-actions">
        <button class="btn btn-primary" type="submit" data-magnetic>{{ PL.submit or 'Add to cart' }} {{ icon('arrow') }}</button>
        {%- if PL.src %}<a class="btn btn-ghost" href="{{ PL.src }}" rel="noopener">See it on macroboost.com</a>{% endif %}
      </div>
    </form>
    <aside class="plan-sum msub-sum" data-plan-sum>
      <p class="side-h">Your subscription</p>
      <p class="plan-big"><b data-sub-price>–</b></p>
      <dl class="co-totals">
        <div><dt>Meals</dt><dd data-sub-meals>–</dd></div>
        <div><dt>Per meal</dt><dd data-sub-per>–</dd></div>
        <div data-sub-save-row hidden><dt>Saved vs weekly</dt><dd data-sub-save>–</dd></div>
      </dl>
      <p class="co-hint">{{ PL.note }}</p>
    </aside>
  </div>
  <script type="application/json" data-sub-tiers>{{ PL.tiers | tojson }}</script>
</section>
<section class="pg-section">
  <div class="wrap">
    <p class="eyebrow">Prices</p>
    <h2 class="pg-h2" data-anim="lines">Every option, every price</h2>
    <div class="msub-table" data-anim="up">
      <div class="msub-row msub-head"><span></span>{% for p in PL.periods %}<span>{{ p.label }} <small>{{ p.sub }}</small></span>{% endfor %}</div>
      {%- for ml in PL.meals %}
      <div class="msub-row"><span><img src="{{ m.src('cut:' ~ ml.image) }}" alt="" loading="lazy">{{ ml.n }} meal{{ '' if ml.n == 1 else 's' }} a day</span>{% for p in PL.periods %}{% set k = p.key ~ ml.n %}<span><b>{{ money(PL.tiers[k]) }}</b><small>{{ money(PL.tiers[k] / (p.days * ml.n)) }} a meal</small></span>{% endfor %}</div>
      {%- endfor %}
    </div>
    <p class="co-hint">{{ PL.note }}</p>
  </div>
</section>
<section class="pg-section alt">
  <div class="wrap msub-info">
    <div><p class="eyebrow">Included</p><h3 class="pg-h3">What's in every subscription</h3><ul class="check-list">{% for t in PL.includes %}<li data-anim="up">{{ icon('check') }}<span>{{ t }}</span></li>{% endfor %}</ul></div>
    <div><p class="eyebrow">Choosing meals</p><h3 class="pg-h3">From the restaurant menu</h3><p class="muted">{{ PL.menu_text }}</p>
      {%- if PL.excluded %}<p class="msub-ex-h">Not included</p><ul class="spec-chips pd-tags">{% for t in PL.excluded %}<li><span>{{ t }}</span></li>{% endfor %}</ul>{% endif %}</div>
    <div><p class="eyebrow">Good to know</p><h3 class="pg-h3">The rules</h3><ul class="check-list">{% for t in PL.rules %}<li data-anim="up">{{ icon('check') }}<span>{{ t }}</span></li>{% endfor %}</ul></div>
  </div>
</section>
{%- else %}
{%- if PL.steps %}
<section class="pg-section">
  <div class="wrap">
    <p class="eyebrow">How it works</p>
    <div class="point-grid">{% for h in PL.steps %}<article class="point-card" data-anim="up" data-delay="{{ (loop.index0 % 3) * 0.08 }}"><span class="point-n">{{ '%02d' % loop.index }}</span><h3>{{ h.title }}</h3><p>{{ h.text }}</p></article>{% endfor %}</div>
  </div>
</section>
{%- endif %}
<section class="pg-section alt" data-plan>
  <div class="wrap plan-grid">
    <form class="plan-form" data-plan-form novalidate>
      <h2 class="pg-h2" data-anim="lines">{{ PL.builder_title or 'Build your plan' }}</h2>
      <fieldset class="co-step"><legend><span class="co-n">1</span>Your goal</legend>
        <div class="seg seg-wrap">{% for g in PL.goals %}<label class="seg-opt"><input type="radio" name="goal" value="{{ g.label }}"{% if loop.first %} checked{% endif %}><span><b>{{ g.label }}</b><small>{{ g.text }}</small></span></label>{% endfor %}</div>
      </fieldset>
      <fieldset class="co-step"><legend><span class="co-n">2</span>Size</legend>
        <div class="plan-dials">
          {%- for key, label, opts in [('meals', 'Meals a day', PL.meals or [2, 3]), ('days', 'Days a week', PL.days or [5, 6]), ('weeks', 'Weeks', PL.weeks or [1, 4])] %}
          <div class="dial"><span>{{ label }}</span><div class="pd-chips">{% for o in opts %}<label class="pd-chip-r"><input type="radio" name="{{ key }}" value="{{ o }}"{% if loop.first %} checked{% endif %}><span>{{ o }}</span></label>{% endfor %}</div></div>
          {%- endfor %}
        </div>
      </fieldset>
      <fieldset class="co-step"><legend><span class="co-n">3</span>Pick the meals you like <i class="plan-pick-n" data-plan-n></i></legend>
        <div class="plan-picks">
          {%- for it in s.catalogue['items'] if it.category in (PL.categories or []) and it._sku %}
          <label class="plan-pick"><input type="checkbox" name="pick" value="{{ it._sku }}"{% if it.featured %} checked{% endif %}>
            <span class="pp-img">{% if it._img %}<img src="{{ m.src(it._img) }}" alt="" loading="lazy">{% endif %}</span>
            <span class="pp-t"><b>{{ it.title }}</b><small>{{ it.price }}{% for k in it.macros or [] if k.label in ('kcal', 'protein') %} · {{ k.value }} {{ k.label }}{% endfor %}</small></span></label>
          {%- endfor %}
        </div>
      </fieldset>
      <fieldset class="co-step"><legend><span class="co-n">4</span>Your details</legend>
        <div class="co-fields">
          <label class="fld"><span>Name</span><input name="name" autocomplete="name" required></label>
          <label class="fld"><span>Mobile</span><input name="phone" type="tel" autocomplete="tel" placeholder="+968" required></label>
          <label class="fld fld-wide"><span>Allergies or notes <i>(optional)</i></span><input name="notes"></label>
        </div>
      </fieldset>
      <p class="co-error" data-co-error role="alert" hidden></p>
      <button class="btn btn-primary" type="submit">{{ PL.submit or 'Send my plan request' }} {{ icon('arrow') }}</button>
    </form>
    <aside class="plan-sum" data-plan-sum>
      <p class="side-h">Your plan</p>
      <p class="plan-big"><b data-plan-meals>0</b> meals</p>
      <dl class="co-totals">
        <div><dt>Average a day</dt><dd data-plan-kcal>–</dd></div>
        <div><dt>Protein a day</dt><dd data-plan-protein>–</dd></div>
        <div class="co-grand"><dt>Estimate</dt><dd data-plan-est>–</dd></div>
      </dl>
      <p class="co-hint">{{ PL.note }}</p>
    </aside>
  </div>
</section>
{%- endif %}
{% endblock %}
