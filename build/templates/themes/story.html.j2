{% extends "base.html.j2" %}
{% import "partials/macros.j2" as m with context %}
{% import "partials/anatomy.j2" as an %}

{% macro wave(cls, flip=false) -%}
<svg class="wave {{ cls }}{% if flip %} wave-flip{% endif %}" viewBox="0 0 1440 120" preserveAspectRatio="none" data-waves aria-hidden="true"><path d="M0 120 L0 60 L1440 60 L1440 120 Z"/><path d="M0 120 L0 80 L1440 80 L1440 120 Z"/></svg>
{%- endmacro %}

{% block content %}
{{ an.defs() }}
<section class="hero" id="top">
  <canvas class="hero-fx" data-fx="floaters" aria-hidden="true"></canvas>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow" data-anim="up" data-intro>{{ s.hero.eyebrow }}</p>
      <h1 class="hero-title" data-anim="lines" data-intro>{{ s.theme_data.hero_html | safe }}</h1>
      <p class="hero-lede" data-anim="up" data-intro data-delay=".45">{{ s.hero.lede }}</p>
      <div class="cta-row" data-anim="up" data-intro data-delay=".6">
        <a class="btn btn-primary" href="{{ s.hero.primary.href }}" data-magnetic>{{ s.hero.primary.label }} {{ icon('arrow') }}</a>
        <a class="btn btn-ghost" href="{{ s.hero.secondary.href }}" data-magnetic>{{ s.hero.secondary.label }}</a>
      </div>
    </div>
    <div class="hero-visual">
      <p class="giant giant-back" aria-hidden="true" data-drift="30">{{ s.theme_data.giant }}</p>
      <div class="body-wrap" data-intro-body>
        {{ an.body() }}
        {%- for it in s.services['items'] %}
        <a class="hotspot" href="#c-{{ it.kind }}" style="--x: {{ '%.2f' % (it.spot[0] / 3) }}%; --y: {{ '%.2f' % (it.spot[1] / 6.4) }}%; --i: {{ loop.index0 }}">
          <span class="hs-dot" aria-hidden="true"></span><span class="hs-label">{{ it.title }}</span>
        </a>
        {%- endfor %}
      </div>
      <p class="giant giant-front" aria-hidden="true" data-drift="30">{{ s.theme_data.giant }}</p>
      {%- for b in s.theme_data.badges %}
      <div class="badge badge-{{ loop.index }}" data-anim="scale" data-intro data-delay="{{ 0.8 + loop.index0 * 0.15 }}">
        <strong>{{ m.count(b) }}</strong><span>{{ b.label }}</span>
      </div>
      {%- endfor %}
    </div>
  </div>
  {{ wave('to-teal') }}
</section>

<section class="band" aria-label="Key figures">
  <div class="wrap band-row">
    {%- for st in s.stats %}
    <div class="band-stat" data-anim="up" data-delay="{{ loop.index0 * 0.08 }}">
      <strong>{{ m.count(st) }}</strong>
      <span>{{ st.label }}</span>
    </div>
    {%- endfor %}
  </div>
  {{ wave('from-teal', true) }}
</section>

<section class="chapters" id="about" data-chapters>
  <p class="giant giant-mid" aria-hidden="true" data-drift="24">{{ s.theme_data.giant2 }}</p>
  <div class="wrap chapter-grid">
    <div class="chapter-sticky">
      <div class="chapter-num" aria-hidden="true"><span data-chapter-num>1</span></div>
      <div class="chapter-frames">
        {%- for c in s.theme_data.chapters %}
        <div class="chapter-frame" data-chapter-media>{{ m.img(c.image, 'chapter-media') }}</div>
        {%- endfor %}
      </div>
    </div>
    <div class="chapter-list">
      <div class="chapter-intro">
        <p class="eyebrow">About</p>
        <h2 data-anim="lines">{{ s.about.title }}</h2>
        {%- for p in s.about.body %}<p class="muted" data-anim="up">{{ p }}</p>{% endfor %}
      </div>
      {%- for c in s.theme_data.chapters %}
      <article class="chapter" data-chapter>
        <span class="chapter-k">{{ loop.index }}</span>
        <h3>{{ c.title }}</h3>
        <p>{{ c.text }}</p>
        {% if c.link %}<a class="text-link" href="{{ c.link.href }}">{{ c.link.label }} {{ icon('arrow') }}</a>{% endif %}
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="centres" id="services">
  <div class="wrap centres-head">
    <p class="eyebrow">{{ s.services.nav }}</p>
    <h2 data-anim="lines">{{ s.services.title }}</h2>
    <p class="muted" data-anim="up">{{ s.services.intro }}</p>
  </div>
  <div class="wrap organ-grid">
    {%- for it in s.services['items'] %}
    <article class="organ-card" id="c-{{ it.kind }}" data-anim="up" data-delay="{{ (loop.index0 % 4) * 0.08 }}">
      <div class="organ-stage">
        {%- if it.bg %}<img class="organ-bg" src="{{ m.src(it.bg) }}" alt="" loading="lazy" decoding="async"><span class="stage-cap">{{ s.images[it.bg].cap }}</span>{% endif %}
        {{ an.organ(it.kind) }}
      </div>
      <div class="organ-copy">
        <span class="organ-n">{{ '%02d' % loop.index }}</span>
        <h3>{{ it.title }}</h3>
        <p>{{ it.area }}</p>
      </div>
    </article>
    {%- endfor %}
  </div>
  <div class="wrap">
    <div class="chips-block" data-anim="up">
      <h3>{{ s.services.chips_title }}</h3>
      <ul class="chips">{% for c in s.services.chips %}<li>{{ c }}</li>{% endfor %}</ul>
    </div>
  </div>
</section>

<section class="moments" aria-label="Moments of care">
  <div class="wrap moments-row">
    {%- for r in s.theme_data.moments %}
    {{ m.img(r, 'moment moment-' ~ loop.index, 'img', ['1', '-1', '1.5'][loop.index0 % 3]) }}
    {%- endfor %}
  </div>
  <p class="wrap moments-note">Placeholder photography. Replace with Badr Al Samaa's own hospital photos, inside and out, before use.</p>
</section>

<section class="packages" id="highlights">
  <div class="wrap">
    <p class="eyebrow">{{ s.highlights.nav }}</p>
    <h2 data-anim="lines">{{ s.highlights.title }}</h2>
    <p class="muted" data-anim="up">{{ s.highlights.intro }}</p>
    <div class="pkg-row">
      {%- for it in s.highlights['items'] %}
      <div class="pkg-cell" data-anim="up" data-delay="{{ loop.index0 * 0.1 }}">
      <article class="pkg{% if it.bg %} pkg-photo{% endif %}" style="--r: {{ [-6, 4, -3, 7][loop.index0 % 4] }}deg">
        {%- if it.bg %}<img class="pkg-bg" src="{{ m.src(it.bg) }}" alt="{{ s.images[it.bg].alt }}" loading="lazy" decoding="async"><span class="stage-cap">{{ s.images[it.bg].cap }}</span>{% endif %}
        <span class="pkg-k">Package 0{{ loop.index }}</span>
        <span class="pkg-ico">{{ icon(it.icon) }}</span>
        <h3>{{ it.title }}</h3>
        <span class="pkg-foot">Preventive check-up</span>
      </article>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="countries" id="locations">
  {{ wave('to-cream2') }}
  <div class="wrap">
    <p class="eyebrow">{{ s.locations.nav }}</p>
    <h2 data-anim="lines">{{ s.locations.title }}</h2>
    <p class="muted" data-anim="up">{{ s.locations.intro }}</p>
    <div class="country-row">
      {%- for c in s.theme_data.countries %}
      <button class="country-card" type="button" data-cursor="Filter" data-filter-proxy="{{ c.name }}" data-anim="up" data-delay="{{ loop.index0 * 0.08 }}">
        {%- if c.image %}{{ m.img(c.image, 'country-media') }}{% else %}<span class="country-media country-blank" aria-hidden="true"></span>{% endif %}
        <span class="country-name">{{ c.name }}</span>
        {%- set n = s._country_counts[c.name] %}<span class="country-n">{{ n }} {{ 'branch' if n == 1 else 'branches' }}</span>
      </button>
      {%- endfor %}
    </div>
    <div class="curve" data-curve tabindex="0" aria-roledescription="carousel" aria-label="Branches">
      <div class="filters curve-filters" role="group" aria-label="Filter branches by country">
        <button class="filter" type="button" data-cfilter="all" aria-pressed="true">All <span class="filter-n">{{ s.locations['items'] | length }}</span></button>
        {%- for c, n in s._countries %}
        <button class="filter" type="button" data-cfilter="{{ c }}" aria-pressed="false">{{ c }} <span class="filter-n">{{ n }}</span></button>
        {%- endfor %}
      </div>
      <div class="curve-stage" data-cursor="Drag">
        <ul class="curve-track">
          {%- for l in s.locations['items'] %}
          {%- set im = s.images[l.image] %}
          <li class="curve-card" data-c="{{ l.country }}" data-name="{{ l.name }}" data-type="{{ l.type }}" data-cap="{{ im.cap }}" data-address="{{ l.address or '' }}" data-phone="{{ l.phone or '' }}" data-note="{{ l.note or '' }}">
            <img class="cc-bg" src="assets/img/{{ im.src }}" alt="" loading="lazy" decoding="async" draggable="false">
            <div class="cc-top"><span class="cc-pill">{{ l.type }}</span><span>{{ l.country }}</span></div>
            <div class="cc-bottom">
              <span class="cc-n">{{ '%02d' % loop.index }}</span>
              <h3>{{ l.name }}</h3>
              <span class="cc-cap">{{ im.cap }}</span>
            </div>
          </li>
          {%- endfor %}
        </ul>
      </div>
      {%- set first = s.locations['items'][0] %}
      <div class="curve-ui">
        <button class="curve-btn" type="button" data-cprev aria-label="Previous branch">{{ icon('arrow') }}</button>
        <div class="curve-detail" aria-live="polite">
          <span class="cd-type" data-d="type">{{ first.type }}</span>
          <h3 class="cd-name" data-d="name">{{ first.name }}</h3>
          <p class="cd-meta"><span data-d="country">{{ first.country }}</span> · <span data-d="cap">{{ s.images[first.image].cap }}</span></p>
          <p class="cd-line" data-d="info">Branch listed on the group's website. Full address to be confirmed.</p>
          <div class="cd-actions">
            <a class="btn btn-primary btn-sm" href="#contact" data-d="book" data-magnetic>Book at this branch {{ icon('arrow') }}</a>
            <a class="cd-phone" href="tel:+96822717171">24/7 helpline · +968 2271 7171</a>
          </div>
        </div>
        <button class="curve-btn next" type="button" data-cnext aria-label="Next branch">{{ icon('arrow') }}</button>
      </div>
      <div class="curve-progress"><span data-counter>01 / {{ '%02d' % s.locations['items'] | length }}</span><i><b data-cbar></b></i></div>
    </div>
  </div>
</section>
{% endblock %}
