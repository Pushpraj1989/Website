{% extends "base.html.j2" %}
{% import "partials/macros.j2" as m with context %}

{% macro wave(cls, flip=false) -%}
<svg class="wave {{ cls }}{% if flip %} wave-flip{% endif %}" viewBox="0 0 1440 120" preserveAspectRatio="none" data-waves aria-hidden="true"><path d="M0 120 L0 60 L1440 60 L1440 120 Z"/><path d="M0 120 L0 80 L1440 80 L1440 120 Z"/></svg>
{%- endmacro %}

{% block content %}
<section class="hero" id="top">
  <canvas class="hero-fx" data-fx="floaters" aria-hidden="true"></canvas>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow" data-anim="up" data-intro>{{ s.hero.eyebrow }}</p>
      <h1 class="hero-title" data-anim="lines" data-intro>{{ s.theme_data.hero_html | safe }}</h1>
      <p class="hero-lede" data-anim="up" data-intro data-delay=".45">{{ s.hero.lede }}</p>
      <div class="cta-row" data-anim="up" data-intro data-delay=".6">
        <a class="btn btn-primary" href="{{ s.hero.primary.href }}" data-magnetic>{{ s.hero.primary.label }} {{ icon('arrow') }}</a>
        <a class="btn btn-ghost" href="{{ s.hero.secondary.href }}" data-magnetic>{{ s.hero.secondary.label }}</a>
      </div>
    </div>
    <div class="hero-visual">
      <p class="giant giant-back" aria-hidden="true" data-drift="30">{{ s.theme_data.giant }}</p>
      <div class="hero-arch" data-anim="img" data-intro>{{ m.img('hero', 'arch-media') }}</div>
      <p class="giant giant-front" aria-hidden="true" data-drift="30">{{ s.theme_data.giant }}</p>
      {%- for b in s.theme_data.badges %}
      <div class="badge badge-{{ loop.index }}" data-anim="scale" data-intro data-delay="{{ 0.8 + loop.index0 * 0.15 }}">
        <strong>{{ m.count(b) }}</strong><span>{{ b.label }}</span>
      </div>
      {%- endfor %}
    </div>
  </div>
  {{ wave('to-teal') }}
</section>

<section class="band" aria-label="Key figures">
  <div class="wrap band-row">
    {%- for st in s.stats %}
    <div class="band-stat" data-anim="up" data-delay="{{ loop.index0 * 0.08 }}">
      <strong>{{ m.count(st) }}</strong>
      <span>{{ st.label }}</span>
    </div>
    {%- endfor %}
  </div>
  {{ wave('from-teal', true) }}
</section>

<section class="chapters" id="about" data-chapters>
  <p class="giant giant-mid" aria-hidden="true" data-drift="24">{{ s.theme_data.giant2 }}</p>
  <div class="wrap chapter-grid">
    <div class="chapter-sticky">
      <div class="chapter-num" aria-hidden="true"><span data-chapter-num>1</span></div>
      <div class="chapter-frames">
        {%- for c in s.theme_data.chapters %}
        <div class="chapter-frame" data-chapter-media>{{ m.img(c.image, 'chapter-media') }}</div>
        {%- endfor %}
      </div>
    </div>
    <div class="chapter-list">
      <div class="chapter-intro">
        <p class="eyebrow">About</p>
        <h2 data-anim="lines">{{ s.about.title }}</h2>
        {%- for p in s.about.body %}<p class="muted" data-anim="up">{{ p }}</p>{% endfor %}
      </div>
      {%- for c in s.theme_data.chapters %}
      <article class="chapter" data-chapter>
        <span class="chapter-k">{{ loop.index }}</span>
        <h3>{{ c.title }}</h3>
        <p>{{ c.text }}</p>
        {% if c.link %}<a class="text-link" href="{{ c.link.href }}">{{ c.link.label }} {{ icon('arrow') }}</a>{% endif %}
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="centres" id="services">
  <div class="wrap centres-head">
    <p class="eyebrow">{{ s.services.nav }}</p>
    <h2 data-anim="lines">{{ s.services.title }}</h2>
    <p class="muted" data-anim="up">{{ s.services.intro }}</p>
  </div>
  <div class="orbit-wrap">
    <div class="orbit-core" data-anim="scale">
      <strong>{{ s.services['items'] | length }}</strong>
      <span>centres of<br>excellence</span>
    </div>
    <ul class="orbit" data-orbit>
      {%- for it in s.services['items'] %}
      <li class="orbit-card" style="--a: {{ (360 / s.services['items']|length) * loop.index0 }}deg">
        <div class="orbit-inner">
          <span class="orbit-ico">{{ icon(it.icon) }}</span>
          <span class="orbit-t">{{ it.title }}</span>
        </div>
      </li>
      {%- endfor %}
    </ul>
  </div>
  <div class="wrap">
    <div class="chips-block" data-anim="up">
      <h3>{{ s.services.chips_title }}</h3>
      <ul class="chips">{% for c in s.services.chips %}<li>{{ c }}</li>{% endfor %}</ul>
    </div>
  </div>
</section>

<section class="packages" id="highlights">
  <div class="wrap">
    <p class="eyebrow">{{ s.highlights.nav }}</p>
    <h2 data-anim="lines">{{ s.highlights.title }}</h2>
    <p class="muted" data-anim="up">{{ s.highlights.intro }}</p>
    <div class="pkg-row">
      {%- for it in s.highlights['items'] %}
      <article class="pkg" style="--r: {{ [-6, 4, -3, 7][loop.index0 % 4] }}deg" data-anim="up" data-delay="{{ loop.index0 * 0.1 }}">
        <span class="pkg-k">Package 0{{ loop.index }}</span>
        <span class="pkg-ico">{{ icon(it.icon) }}</span>
        <h3>{{ it.title }}</h3>
        <span class="pkg-foot">Preventive check-up</span>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="countries" id="locations">
  {{ wave('to-cream2') }}
  <div class="wrap">
    <p class="eyebrow">{{ s.locations.nav }}</p>
    <h2 data-anim="lines">{{ s.locations.title }}</h2>
    <p class="muted" data-anim="up">{{ s.locations.intro }}</p>
    <div class="country-row">
      {%- for c in s.theme_data.countries %}
      <button class="country-card" type="button" data-cursor="Filter" data-filter-proxy="{{ c.name }}" data-anim="up" data-delay="{{ loop.index0 * 0.08 }}">
        {%- if c.image %}{{ m.img(c.image, 'country-media') }}{% else %}<span class="country-media country-blank" aria-hidden="true"></span>{% endif %}
        <span class="country-name">{{ c.name }}</span>
        {%- set n = s._country_counts[c.name] %}<span class="country-n">{{ n }} {{ 'branch' if n == 1 else 'branches' }}</span>
      </button>
      {%- endfor %}
    </div>
    {{ m.locations() }}
  </div>
</section>
{% endblock %}
