{% extends "base.html.j2" %}
{% import "partials/macros.j2" as m with context %}
{% block content %}

<section class="hero" id="top">
  {{ m.img('hero', 'hero-media') }}
  <div class="hero-shade" aria-hidden="true"></div>
  <canvas class="hero-fx" data-fx="embers" aria-hidden="true"></canvas>

  <span class="side-label side-l mono" aria-hidden="true">Est. {{ s.theme_data.est }}</span>
  <span class="side-label side-r mono" aria-hidden="true">Muscat · Oman</span>

  <div class="wrap hero-inner">
    <p class="eyebrow hero-eyebrow" data-anim="up" data-intro>{{ s.hero.eyebrow }}</p>
    <h1 class="hero-title" data-anim="chars" data-intro>{{ s.hero.title }}</h1>
    <div class="hero-foot">
      <p class="hero-lede" data-anim="up" data-intro data-delay=".5">{{ s.hero.lede }}</p>
      <div class="cta-row" data-anim="up" data-intro data-delay=".65">
        <a class="btn btn-primary" href="{{ s.hero.primary.href }}" data-magnetic>{{ s.hero.primary.label }} {{ icon('arrow') }}</a>
        <a class="btn btn-ghost" href="{{ s.hero.secondary.href }}" data-magnetic>{{ s.hero.secondary.label }}</a>
      </div>
    </div>
  </div>
  <div class="hero-dots" aria-hidden="true"><i></i><i></i><i class="on"></i><i></i><i></i></div>
</section>

<section class="stats" aria-label="Key figures">
  <div class="wrap stat-row">
    {%- for st in s.stats %}
    <div class="stat" data-anim="up" data-delay="{{ loop.index0 * 0.08 }}">
      <span class="stat-num">{{ m.count(st) }}</span>
      <span class="stat-lbl">{{ st.label }}</span>
    </div>
    {%- endfor %}
  </div>
</section>

<section class="units" id="services">
  <div class="wrap">
    <p class="eyebrow">{{ s.services.nav }}</p>
    <h2 class="units-title" data-anim="lines">{{ s.theme_data.units_title }}</h2>
    <p class="units-intro" data-anim="up">{{ s.services.intro }}</p>
    <div class="unit-grid" data-assemble>
      {%- for it in s.services['items'] %}
      <article class="unit" data-piece="{{ ['-260,180,-14', '0,260,8', '260,160,16'][loop.index0 % 3] }}">
        {{ m.img(it.image, 'unit-media') }}
        <div class="unit-body">
          <span class="unit-n mono">0{{ loop.index }}</span>
          <h3>{{ it.title }}</h3>
          <p>{{ it.text }}</p>
        </div>
      </article>
      {%- endfor %}
    </div>
    <div class="chip-row" data-anim="up">
      <span class="chip-title">{{ s.services.chips_title }}</span>
      {%- for c in s.services.chips %}<span class="chip">{{ c }}</span>{% endfor %}
    </div>
  </div>
</section>

{{ m.marquee(s.marquee, 1.2, 'left', 'outline-mq') }}

<section class="projects" id="highlights" aria-label="{{ s.highlights.title }}">
  <div class="wrap projects-head">
    <p class="eyebrow">{{ s.highlights.nav }}</p>
    <h2 data-anim="lines">{{ s.highlights.title }}</h2>
    <p data-anim="up">{{ s.highlights.intro }}</p>
  </div>
  <div class="stack" data-stack>
    {%- for it in s.highlights['items'] %}
    <article class="panel" data-panel>
      <div class="panel-inner" data-panel-inner>
        {{ m.img(it.image, 'panel-media') }}
        <div class="panel-shade" aria-hidden="true"></div>
        <div class="wrap panel-copy">
          <span class="panel-n mono">{{ '%02d' % loop.index }} / {{ '%02d' % s.highlights['items']|length }}</span>
          <h3 class="panel-title">{{ it.title }}</h3>
          <span class="panel-tag">{{ it.text }}</span>
        </div>
      </div>
    </article>
    {%- endfor %}
  </div>
</section>

<section class="about" id="about">
  <div class="wrap about-grid">
    <div>
      <p class="eyebrow">About</p>
      <h2 class="about-title" data-anim="lines">{{ s.about.title }}</h2>
      {%- for p in s.about.body %}<p class="about-p" data-anim="up">{{ p }}</p>{% endfor %}
      <ul class="points">
        {%- for p in s.about.points %}
        <li data-anim="up" data-delay="{{ loop.index0 * 0.08 }}"><h3>{{ p.title }}</h3><p>{{ p.text }}</p></li>
        {%- endfor %}
      </ul>
    </div>
    <div class="about-media">
      {{ m.img('sparks', 'about-img', 'img') }}
      <canvas class="about-fx" data-fx="embers" data-density=".35" aria-hidden="true"></canvas>
    </div>
  </div>
</section>

<section class="locs" id="locations">
  <div class="wrap">
    <p class="eyebrow">{{ s.locations.nav }}</p>
    <h2 data-anim="lines">{{ s.locations.title }}</h2>
    <p class="muted" data-anim="up">{{ s.locations.intro }}</p>
    {{ m.locations() }}
  </div>
</section>

{% endblock %}
