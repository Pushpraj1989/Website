{%- import "partials/macros.j2" as m with context -%}
<!doctype html>
<html lang="en" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if page and page.kind != 'home' %}{{ page.title }} · {% endif %}{{ s.name }} · Concept redesign</title>
<meta name="description" content="{{ s.meta }}">
<meta name="theme-color" content="{{ s._theme.theme_color }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{{ s._theme.fonts }}">
<link rel="stylesheet" href="assets/core.css">
<link rel="stylesheet" href="assets/{{ s.theme }}.css">
{%- if s.brand and s.brand.style %}<link rel="stylesheet" href="assets/styles.css">{% endif %}
{%- if s.theme == 'studio' %}
{%- set B = s.brand %}
<style>body[data-theme="studio"]{--bg:{{ (B.bg or '#0f0e0d') | safe }};--fg:{{ (B.fg or '#f5efe6') | safe }};--accent:{{ (B.accent or s.accent) | safe }};--accent-ink:{{ (B.accent_ink or '#ffffff') | safe }};--surface:{{ (B.surface or 'color-mix(in srgb, var(--fg) 5%, transparent)') | safe }};--line:color-mix(in srgb, var(--fg) 14%, transparent);--muted:color-mix(in srgb, var(--fg) 64%, transparent);--font-display:{{ (B.font_display or '"Fraunces", Georgia, serif') | safe }};--font-body:{{ (B.font_body or '"Inter", system-ui, sans-serif') | safe }};--loader-bg:{{ (B.accent or s.accent) | safe }};--alt:{{ (B.alt or 'color-mix(in srgb, var(--fg) 4%, var(--bg))') | safe }}}</style>
{%- endif %}
{%- if s.images.hero %}
<link rel="preload" as="image" href="{{ m.src('hero') }}">
{%- endif %}
<script>document.documentElement.classList.replace('no-js', 'js');try{if(sessionStorage.getItem('t1-nav')&&!matchMedia('(prefers-reduced-motion: reduce)').matches){document.documentElement.classList.add('is-arriving');setTimeout(function(){document.documentElement.classList.remove('is-arriving')},2500)}sessionStorage.removeItem('t1-nav')}catch(e){}</script>
</head>
<body data-theme="{{ s.theme }}"{% if s.theme == 'studio' %} data-mode="{{ s.brand.mode or 'dark' }}"{% endif %}{% if s.brand and s.brand.style %} data-style="{{ s.brand.style }}"{% endif %} data-page="{{ page.kind if page else 'home' }}" style="--accent: {{ s.accent }}">
<a class="skip" href="#main">Skip to content</a>
<div class="progress" aria-hidden="true"></div>

<div class="page-wipe" aria-hidden="true"><span>{{ s.short }}</span></div>
{%- if not page or page.kind == 'home' %}
<div class="loader" aria-hidden="true">
  <div class="loader-inner">
    <p class="loader-name">{% for ch in s.short %}<span>{{ ' ' if ch == ' ' else ch }}</span>{% endfor %}</p>
    <div class="loader-bar"><i></i></div>
    <p class="loader-count">000</p>
  </div>
</div>
{%- endif %}
<div class="cursor" aria-hidden="true"><div class="cursor-ring"><span></span></div><div class="cursor-dot"></div></div>

{% block header %}{% include "partials/header.html.j2" %}{% endblock %}

<main id="main">
{% block content %}{% endblock %}
{%- if not page or page.kind in ('home', 'contact') %}
{% include "partials/contact.html.j2" %}
{%- else %}
{% include "partials/cta.html.j2" %}
{%- endif %}
</main>

{% include "partials/footer.html.j2" %}

{% include "partials/nudges.html.j2" %}

<script src="assets/vendor/gsap.min.js" defer></script>
<script src="assets/vendor/ScrollTrigger.min.js" defer></script>
<script src="assets/vendor/lenis.min.js" defer></script>
<script src="assets/fx.js" defer></script>
<script src="assets/core.js" defer></script>
</body>
</html>
