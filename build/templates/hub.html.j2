<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tier 1 Concepts</title>
<meta name="description" content="Six concept redesigns for the Tier 1 prospects, each with its own visual system and motion.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{{ fonts }}">
<link rel="stylesheet" href="assets/hub.css">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="hub-head">
  <div class="wrap hub-head-row">
    <span class="hub-brand">Tier 1 · Concept redesigns</span>
    <span class="hub-meta">{{ sites|length }} sites · Oman</span>
  </div>
</header>

<main id="main">
  <section class="hub-hero wrap">
    <p class="hub-kicker">Prospects pitch pack</p>
    <h1>Six companies. <em>Six</em> distinct sites.</h1>
    <p class="hub-lede">Each concept has its own visual language and motion, built from one data file per company. Open a site, then work through its “to verify” items before showing it to anyone.</p>
  </section>

  <section class="wrap hub-grid" aria-label="Concept sites">
    {%- for s in sites %}
    <a class="hub-card" href="sites/{{ s.slug }}/index.html" style="--accent: {{ s.accent }}; --i: {{ loop.index0 }}">
      <figure class="hub-shot">
        {%- if s._thumb %}<img src="assets/hub/{{ s.slug }}.jpg" alt="Preview of the {{ s.name }} concept" loading="lazy">{% endif %}
        <span class="hub-theme">{{ s._theme.label }}</span>
      </figure>
      <div class="hub-body">
        <p class="hub-sector">{{ s.sector }}</p>
        <h2>{{ s.name }}</h2>
        <p class="hub-motion">{{ s._theme.motion }}</p>
        <p class="hub-foot"><span>{{ s.confirm|length }} to verify</span><span class="hub-open">Open concept →</span></p>
      </div>
    </a>
    {%- endfor %}
  </section>

  <p class="wrap hub-note">Concept redesigns, not the companies' official websites, and not affiliated with them. Facts come from each homepage read on 11 Oct 2026 and the prospects document. Photography is Creative Commons, credited in each site's footer. The full checklist is in <code>VERIFY.md</code>.</p>
</main>

<footer class="hub-footer wrap">
  <p>© {{ year }} Concept redesigns.</p>
</footer>
</body>
</html>
