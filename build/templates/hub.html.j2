<!doctype html>
<html lang="en" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tier 1 concept redesigns</title>
<meta name="description" content="Concept redesigns for the six Tier 1 prospects.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Manrope:wght@400;500;600;700;800&display=swap">
<link rel="stylesheet" href="assets/site.css">
<script>document.documentElement.classList.replace('no-js', 'js');</script>
</head>
<body class="hub-body">
<a class="skip" href="#main">Skip to content</a>
<div class="progress" aria-hidden="true"></div>

<header class="hub-head">
  <div class="wrap hub-head-row">
    <span class="brand-text">Tier 1 concept redesigns</span>
    <span class="muted-light">{{ sites|length }} sites</span>
  </div>
</header>

<main id="main">
<section class="hub-hero">
  <div class="wrap">
    <p class="kicker" data-reveal>Tier 1 prospects · Oman</p>
    <h1 class="hub-title" data-reveal style="--d: .08s">Six concept sites, one system</h1>
    <p class="lede" data-reveal style="--d: .18s">Each site uses the same design system and is built from one data file. Open a site to review the redesign, then check the items listed under “Verify” before any pitch.</p>
  </div>
</section>

<section class="section" id="sites">
  <div class="wrap">
    <div class="hub-grid">
      {% for s in sites %}
      <article class="card spot hub-card" data-reveal style="--d: {{ (loop.index0 % 3) * 0.08 }}s; --accent: {{ s.accent }}">
        <p class="pill">{{ s.sector }}</p>
        <h2 class="hub-card-title">{{ s.name }}</h2>
        <p class="muted">{{ s.meta }}</p>
        <div class="hub-card-foot">
          <span class="verify-count">{{ s.confirm|length }} to verify</span>
          <a class="btn btn-primary btn-sm" href="sites/{{ s.slug }}/index.html">Open concept {{ icon('arrow') }}</a>
        </div>
      </article>
      {% endfor %}
    </div>

    <p class="note hub-note">Concept redesigns, not the companies' official sites. Facts are from the homepages read on 11 Oct 2026 and the prospects document. The full list of items to check is in <code>VERIFY.md</code>.</p>
  </div>
</section>
</main>

<footer class="site-footer">
  <div class="wrap foot-bottom">
    <p>© {{ year }} Concept redesigns. Not affiliated with the companies shown.</p>
    <a href="#top">Back to top</a>
  </div>
</footer>

<a class="to-top" href="#main" data-to-top aria-label="Back to top">{{ icon('arrow') }}</a>

<script src="assets/motion.js" defer></script>
</body>
</html>
