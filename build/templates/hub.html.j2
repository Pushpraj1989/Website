<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Client Sites</title>
<meta name="description" content="Concept websites built with the premium website kit, each from the client's own content, photos and logo.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{{ fonts }}">
<link rel="stylesheet" href="assets/hub.css">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="hub-head">
  <div class="wrap hub-head-row">
    <span class="hub-brand">Client sites · Concept builds</span>
    <span class="hub-meta">{{ sites|length }} sites · Oman</span>
  </div>
</header>

<main id="main">
  <section class="hub-hero wrap">
    <p class="hub-kicker">Pitch pack · {{ sites|length }} clients · {{ sites | map(attribute='_pages') | map('length') | sum }} pages</p>
    <h1>Every client. <em>Its own</em> moving site.</h1>
    <p class="hub-lede">Built from each company's real website, photos and logo, with scroll-driven motion, product films and detail pages. Open a site, then work through its “to verify” items before showing it to anyone.</p>
  </section>

  <section class="wrap hub-grid" aria-label="Concept sites">
    {%- for s in sites %}
    <a class="hub-card" href="sites/{{ s.slug }}/index.html" style="--accent: {{ s.accent }}; --i: {{ loop.index0 }}">
      <figure class="hub-shot">
        {%- if s._thumb %}<img src="assets/hub/{{ s.slug }}.jpg" alt="Preview of the {{ s.name }} concept" loading="lazy">{% endif %}
        <span class="hub-theme">{{ s._pages | length }} pages</span>
      </figure>
      <div class="hub-body">
        {%- if s._logo %}<span class="hub-logo"><img src="{{ s._logo }}" alt="{{ s.name }} logo"></span>{% endif %}
        <p class="hub-sector">{{ s.sector }}</p>
        <h2>{{ s.name }}</h2>
        <p class="hub-motion">{{ s.hub_line or s.meta | truncate(120) }}</p>
        <p class="hub-url">/sites/{{ s.slug }}/{% if s._alt %} · <span lang="ar">العربية</span> /sites/{{ s.slug }}/ar/{% endif %}</p>
        <p class="hub-foot"><span>{{ s.confirm|length }} to verify</span><span class="hub-open">Open concept →</span></p>
      </div>
    </a>
    {%- endfor %}
  </section>

  <p class="wrap hub-note">Concept redesigns, not the companies' official websites, and not affiliated with them. Facts, products and photos come from each company's own website (read 11–12 Oct 2026); any stock imagery is credited in the site's footer. The full checklist is in <code>VERIFY.md</code>.</p>
</main>

<footer class="hub-footer wrap">
  <p>© {{ year }} Concept redesigns.</p>
</footer>
</body>
</html>
